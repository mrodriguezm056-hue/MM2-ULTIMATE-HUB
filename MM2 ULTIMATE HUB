export type DummyPattern = "Linear" | "ZigZag" | "Jump"

type ActiveDummyMotion = {
	model: Model,
	root: BasePart,
	originCFrame: CFrame,
	pattern: DummyPattern,
	speed: number,
	amplitude: number,
	elapsed: number,
}

local SimulationController = {}
SimulationController.__index = SimulationController

function SimulationController.new(localPlayer: Player?): any
	local self = {
		localPlayer = localPlayer,
		activeProjectiles = {} :: { RBXScriptConnection },
		trackedMotions = {} :: { [string]: ActiveDummyMotion },
	}
	return setmetatable(self, SimulationController)
end

function SimulationController:SetDummyMotion(
	id: string,
	model: Model,
	root: BasePart,
	pattern: DummyPattern,
	speed: number?,
	amplitude: number?
)
	self.trackedMotions[id] = {
		model = model,
		root = root,
		originCFrame = root.CFrame,
		pattern = pattern,
		speed = if type(speed) == "number" then speed else 14,
		amplitude = if type(amplitude) == "number" then amplitude else 8,
		elapsed = 0,
	}
end

function SimulationController:ClearDummyMotions()
	table.clear(self.trackedMotions)
end

function SimulationController:StepMotions(dt: number)
	local safeDt = if type(dt) == "number" and dt > 0 and dt < 0.25 then dt else (1 / 60)

	for id, motion in pairs(self.trackedMotions) do
		if not motion.model.Parent or not motion.root.Parent then
			self.trackedMotions[id] = nil
		else
			motion.elapsed += safeDt
			local t = motion.elapsed
			local basePos = motion.originCFrame.Position
			local offset = Vector3.zero

			if motion.pattern == "Linear" then
				local travel = math.sin(t * (motion.speed / math.max(motion.amplitude, 1))) * motion.amplitude
				offset = Vector3.new(travel, 0, 0)
			elseif motion.pattern == "ZigZag" then
				local x = math.sin(t * 2.2) * motion.amplitude
				local z = math.cos(t * 1.1) * (motion.amplitude * 0.6)
				offset = Vector3.new(x, 0, z)
			elseif motion.pattern == "Jump" then
				local x = math.sin(t * 1.4) * (motion.amplitude * 0.7)
				local jumpArc = math.abs(math.sin(t * 3.0)) * 5.5
				offset = Vector3.new(x, jumpArc, 0)
			end

			motion.root.CFrame = CFrame.new(basePos + offset) * motion.originCFrame.Rotation
		end
	end
end

function SimulationController:SpawnProjectile(params: {
	originPos: Vector3,
	direction: Vector3,
	speed: number,
	color: Color3?,
	targetModel: Model?,
	maxLifetime: number?,
	onComplete: ((hitPos: Vector3, hitTarget: boolean, hitInstance: Instance?) -> ())?,
})
	local dir = if params.direction.Magnitude > 1e-5 then params.direction.Unit else Vector3.new(0, 0, -1)
	local speed = math.max(10, params.speed)
	local lifetime = if type(params.maxLifetime) == "number" and params.maxLifetime > 0 then params.maxLifetime else 2.5

	local proj = Instance.new("Part")
	proj.Name = "NovaHub_SimProjectile"
	proj.Size = Vector3.new(0.3, 0.3, 2.0)
	proj.Material = Enum.Material.Neon
	proj.Color = params.color or Color3.fromRGB(255, 195, 95)
	proj.Anchored = true
	proj.CanCollide = false
	proj.CastShadow = false
	proj.CFrame = CFrame.lookAt(params.originPos, params.originPos + dir)
	proj.Parent = workspace

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { proj }
	if self.localPlayer and self.localPlayer.Character then
		table.insert(ignore, self.localPlayer.Character)
	end
	rayParams.FilterDescendantsInstances = ignore
	rayParams.IgnoreWater = true

	local curPos = params.originPos
	local elapsed = 0
	local finished = false
	local conn: RBXScriptConnection

	local function finish(hitPos: Vector3, hitTarget: boolean, hitInst: Instance?)
		if finished then
			return
		end
		finished = true
		if conn then
			conn:Disconnect()
		end
		if params.onComplete then
			params.onComplete(hitPos, hitTarget, hitInst)
		end
		task.delay(0.15, function()
			if proj.Parent then
				proj:Destroy()
			end
		end)
	end

	conn = game:GetService("RunService").Heartbeat:Connect(function(dt: number)
		if finished then
			return
		end
		elapsed += dt
		local stepDist = speed * dt
		local hit = workspace:Raycast(curPos, dir * stepDist, rayParams)

		if hit then
			proj.Position = hit.Position
			local isTarget = false
			if params.targetModel and hit.Instance:IsDescendantOf(params.targetModel) then
				isTarget = true
			end
			finish(hit.Position, isTarget, hit.Instance)
			return
		end

		curPos = curPos + dir * stepDist
		proj.CFrame = CFrame.lookAt(curPos, curPos + dir)

		if elapsed >= lifetime then
			finish(curPos, false, nil)
		end
	end)

	table.insert(self.activeProjectiles, conn)
end


