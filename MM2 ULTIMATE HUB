-- ============================================================================
-- 1. ReplicatedStorage/AutoPredictionEngine (ModuleScript)
-- ============================================================================
--!strict
export type AxisWeights = {
	X: number,
	Y: number,
	Z: number,
}

export type PredictionConfig = {
	AutoPrediction: boolean,
	PredictionStrength: number,
	AxisWeights: AxisWeights,
	DynamicPrediction: boolean,
	PingCompensation: boolean,
	PingSeconds: number,
	ProjectileSpeed: number,
	MaxPredictionTime: number,
	VelocityAlpha: number,
	AccelerationAlpha: number,
	MaxSpeed: number,
	MaxAcceleration: number,
}

export type ErrorSample = {
	id: number,
	targetId: string,
	predictedTime: number,
	distanceStuds: number,
	speedStudsPerSec: number,
	errorStuds: number,
	simulated: boolean,
	timestamp: number,
}

export type ErrorSummary = {
	count: number,
	lastError: number?,
	meanError: number?,
	maxError: number?,
}

type TargetState = {
	sampleCount: number,
	lastPos: Vector3,
	lastTime: number,
	hasPrevVel: boolean,
	velocity: Vector3,
	acceleration: Vector3,
}

type PendingCheck = {
	id: number,
	targetId: string,
	predictedPos: Vector3,
	evaluateAt: number,
	scheduledTime: number,
	distanceStuds: number,
	speedStudsPerSec: number,
	simulated: boolean,
	getCurrentPos: () -> Vector3?,
}

local AutoPredictionEngine = {}
AutoPredictionEngine.__index = AutoPredictionEngine

local MIN_VALID_DT = 1 / 500
local MAX_VALID_DT = 0.25

local function isFiniteNumber(n: unknown): boolean
	return type(n) == "number" and n == n and math.abs(n) ~= math.huge
end

local function sanitizeNumber(val: unknown, fallback: number, minVal: number?, maxVal: number?): number
	if not isFiniteNumber(val) then
		return fallback
	end
	local num = val :: number
	if minVal ~= nil and num < minVal then
		num = minVal
	end
	if maxVal ~= nil and num > maxVal then
		num = maxVal
	end
	return num
end

local function clampVectorMagnitude(vec: Vector3, maxMag: number): Vector3
	local mag = vec.Magnitude
	if mag ~= mag or mag == math.huge then
		return Vector3.zero
	end
	if mag > maxMag and mag > 1e-6 then
		return vec.Unit * maxMag
	end
	return vec
end

function AutoPredictionEngine.new(customConfig: Partial<PredictionConfig>?): any
	local config: PredictionConfig = {
		AutoPrediction = true,
		PredictionStrength = 1.0,
		AxisWeights = { X = 1.0, Y = 1.0, Z = 1.0 },
		DynamicPrediction = true,
		PingCompensation = false,
		PingSeconds = 0.0,
		ProjectileSpeed = 120,
		MaxPredictionTime = 1.0,
		VelocityAlpha = 0.35,
		AccelerationAlpha = 0.20,
		MaxSpeed = 250,
		MaxAcceleration = 600,
	}

	local self = {
		config = config,
		targets = {} :: { [string]: TargetState },
		pendingChecks = {} :: { PendingCheck },
		samples = {} :: { ErrorSample },
		nextCheckId = 1,
		maxSamples = 500,
	}

	setmetatable(self, AutoPredictionEngine)

	if customConfig then
		self:SetConfig(customConfig)
	end

	return self
end

function AutoPredictionEngine:SetConfig(partial: Partial<PredictionConfig>)
	local cfg = self.config
	if type(partial.AutoPrediction) == "boolean" then
		cfg.AutoPrediction = partial.AutoPrediction
	end
	if partial.PredictionStrength ~= nil then
		cfg.PredictionStrength = sanitizeNumber(partial.PredictionStrength, cfg.PredictionStrength, 0, 5)
	end
	if partial.PingCompensation ~= nil and type(partial.PingCompensation) == "boolean" then
		cfg.PingCompensation = partial.PingCompensation
	end
	if partial.DynamicPrediction ~= nil and type(partial.DynamicPrediction) == "boolean" then
		cfg.DynamicPrediction = partial.DynamicPrediction
	end
	if partial.PingSeconds ~= nil then
		cfg.PingSeconds = sanitizeNumber(partial.PingSeconds, cfg.PingSeconds, 0, 2.0)
	end
	if partial.ProjectileSpeed ~= nil then
		cfg.ProjectileSpeed = sanitizeNumber(partial.ProjectileSpeed, cfg.ProjectileSpeed, 0, 5000)
	end
	if partial.MaxPredictionTime ~= nil then
		cfg.MaxPredictionTime = sanitizeNumber(partial.MaxPredictionTime, cfg.MaxPredictionTime, 0.01, 5.0)
	end
	if partial.VelocityAlpha ~= nil then
		cfg.VelocityAlpha = sanitizeNumber(partial.VelocityAlpha, cfg.VelocityAlpha, 0.01, 1.0)
	end
	if partial.AccelerationAlpha ~= nil then
		cfg.AccelerationAlpha = sanitizeNumber(partial.AccelerationAlpha, cfg.AccelerationAlpha, 0.01, 1.0)
	end
	if partial.MaxSpeed ~= nil then
		cfg.MaxSpeed = sanitizeNumber(partial.MaxSpeed, cfg.MaxSpeed, 1, 5000)
	end
	if partial.MaxAcceleration ~= nil then
		cfg.MaxAcceleration = sanitizeNumber(partial.MaxAcceleration, cfg.MaxAcceleration, 1, 20000)
	end
	if type(partial.AxisWeights) == "table" then
		cfg.AxisWeights = {
			X = sanitizeNumber(partial.AxisWeights.X, cfg.AxisWeights.X, -5, 5),
			Y = sanitizeNumber(partial.AxisWeights.Y, cfg.AxisWeights.Y, -5, 5),
			Z = sanitizeNumber(partial.AxisWeights.Z, cfg.AxisWeights.Z, -5, 5),
		}
	end
end

function AutoPredictionEngine:ResetTarget(targetId: string)
	self.targets[targetId] = nil
	for i = #self.pendingChecks, 1, -1 do
		if self.pendingChecks[i].targetId == targetId then
			table.remove(self.pendingChecks, i)
		end
	end
end

function AutoPredictionEngine:ClearAllTargets()
	table.clear(self.targets)
	table.clear(self.pendingChecks)
end

function AutoPredictionEngine:ClearSamples()
	table.clear(self.samples)
end

function AutoPredictionEngine:UpdateTarget(targetId: string, currentPos: Vector3, now: number?): TargetState
	local t = sanitizeNumber(now, os.clock(), 0, math.huge)
	local state = self.targets[targetId]

	if not state then
		state = {
			sampleCount = 1,
			lastPos = currentPos,
			lastTime = t,
			hasPrevVel = false,
			velocity = Vector3.zero,
			acceleration = Vector3.zero,
		}
		self.targets[targetId] = state
		return state
	end

	local rawDt = t - state.lastTime
	if rawDt < MIN_VALID_DT then
		return state
	end

	if rawDt > MAX_VALID_DT then
		state.sampleCount = 1
		state.lastPos = currentPos
		state.lastTime = t
		state.hasPrevVel = false
		state.velocity = Vector3.zero
		state.acceleration = Vector3.zero
		return state
	end

	local deltaPos = currentPos - state.lastPos
	local rawVel = clampVectorMagnitude(deltaPos / rawDt, self.config.MaxSpeed)

	if state.sampleCount == 1 then
		state.velocity = rawVel
		state.sampleCount = 2
	else
		local nextVel = clampVectorMagnitude(state.velocity:Lerp(rawVel, self.config.VelocityAlpha), self.config.MaxSpeed)
		local rawAcc = clampVectorMagnitude((nextVel - state.velocity) / rawDt, self.config.MaxAcceleration)

		if not state.hasPrevVel then
			state.acceleration = rawAcc
			state.hasPrevVel = true
		else
			state.acceleration = clampVectorMagnitude(
				state.acceleration:Lerp(rawAcc, self.config.AccelerationAlpha),
				self.config.MaxAcceleration
			)
		end

		state.velocity = nextVel
		state.sampleCount += 1
	end

	state.lastPos = currentPos
	state.lastTime = t
	return state
end

function AutoPredictionEngine:ComputePredictionTime(originPos: Vector3, targetPos: Vector3, speed: number): number
	local cfg: PredictionConfig = self.config
	local dist = (targetPos - originPos).Magnitude

	local flightTime = 0
	if cfg.ProjectileSpeed > 1e-3 then
		flightTime = dist / cfg.ProjectileSpeed
	end

	local pingTime = if cfg.PingCompensation then cfg.PingSeconds else 0
	local totalTime = flightTime + pingTime

	if cfg.DynamicPrediction then
		local speedFactor = math.clamp(speed / 16, 0.25, 1.15)
		local distanceFactor = 1 / (1 + (dist / 400) ^ 2)
		totalTime = totalTime * speedFactor * distanceFactor
	end

	return math.clamp(totalTime, 0, cfg.MaxPredictionTime)
end

function AutoPredictionEngine:Predict(
	targetId: string,
	originPos: Vector3,
	currentPos: Vector3,
	now: number?
): (Vector3, number, Vector3, { velocity: Vector3, acceleration: Vector3, distance: number, hasEnoughSamples: boolean })
	local t = sanitizeNumber(now, os.clock(), 0, math.huge)
	local state = self:UpdateTarget(targetId, currentPos, t)
	local dist = (currentPos - originPos).Magnitude
	local hasEnoughSamples = state.sampleCount >= 2
	local effectiveVel = if hasEnoughSamples then state.velocity else Vector3.zero
	local effectiveAcc = if state.hasPrevVel then state.acceleration else Vector3.zero

	local info = {
		velocity = effectiveVel,
		acceleration = effectiveAcc,
		distance = dist,
		hasEnoughSamples = hasEnoughSamples,
	}

	if not self.config.AutoPrediction or not hasEnoughSamples then
		return currentPos, 0, Vector3.zero, info
	end

	local predTime = self:ComputePredictionTime(originPos, currentPos, effectiveVel.Magnitude)
	local rawDelta = effectiveVel * predTime + 0.5 * effectiveAcc * (predTime * predTime)

	local weights = self.config.AxisWeights
	local strength = self.config.PredictionStrength

	local scaledDelta = Vector3.new(
		rawDelta.X * weights.X * strength,
		rawDelta.Y * weights.Y * strength,
		rawDelta.Z * weights.Z * strength
	)

	local predictedPos = currentPos + scaledDelta
	return predictedPos, predTime, scaledDelta, info
end

function AutoPredictionEngine:RecordErrorSample(
	targetId: string,
	predictedPos: Vector3,
	actualPos: Vector3,
	predictedTime: number,
	distanceStuds: number,
	speedStudsPerSec: number,
	simulated: boolean?,
	now: number?
): ErrorSample
	local errStuds = (predictedPos - actualPos).Magnitude
	local sample: ErrorSample = {
		id = self.nextCheckId,
		targetId = targetId,
		predictedTime = predictedTime,
		distanceStuds = distanceStuds,
		speedStudsPerSec = speedStudsPerSec,
		errorStuds = errStuds,
		simulated = if simulated == nil then false else simulated,
		timestamp = sanitizeNumber(now, os.clock(), 0, math.huge),
	}

	self.nextCheckId += 1
	table.insert(self.samples, sample)
	if #self.samples > self.maxSamples then
		table.remove(self.samples, 1)
	end

	return sample
end

function AutoPredictionEngine:ScheduleEvaluation(
	targetId: string,
	predictedPos: Vector3,
	predictedTime: number,
	distanceStuds: number,
	speedStudsPerSec: number,
	getCurrentPos: () -> Vector3?,
	simulated: boolean?,
	now: number?
): number?
	local t = sanitizeNumber(now, os.clock(), 0, math.huge)
	local isSim = if simulated == nil then false else simulated

	if predictedTime <= 1e-4 then
		local actual = getCurrentPos()
		if actual then
			local rec = self:RecordErrorSample(
				targetId,
				predictedPos,
				actual,
				0,
				distanceStuds,
				speedStudsPerSec,
				isSim,
				t
			)
			return rec.id
		end
		return nil
	end

	for _, existing in ipairs(self.pendingChecks) do
		if existing.targetId == targetId and math.abs(existing.evaluateAt - (t + predictedTime)) < 1e-3 then
			return existing.id
		end
	end

	local id = self.nextCheckId
	self.nextCheckId += 1

	table.insert(self.pendingChecks, {
		id = id,
		targetId = targetId,
		predictedPos = predictedPos,
		evaluateAt = t + predictedTime,
		scheduledTime = predictedTime,
		distanceStuds = distanceStuds,
		speedStudsPerSec = speedStudsPerSec,
		simulated = isSim,
		getCurrentPos = getCurrentPos,
	})

	return id
end

function AutoPredictionEngine:StepEvaluations(now: number?): { ErrorSample }
	local t = sanitizeNumber(now, os.clock(), 0, math.huge)
	local completed: { ErrorSample } = {}

	for i = #self.pendingChecks, 1, -1 do
		local check = self.pendingChecks[i]
		if t >= check.evaluateAt then
			table.remove(self.pendingChecks, i)
			local actualPos = check.getCurrentPos()
			if actualPos then
				local sample = self:RecordErrorSample(
					check.targetId,
					check.predictedPos,
					actualPos,
					check.scheduledTime,
					check.distanceStuds,
					check.speedStudsPerSec,
					check.simulated,
					t
				)
				table.insert(completed, sample)
			end
		end
	end

	return completed
end

function AutoPredictionEngine:GetErrorSummary(targetId: string?, simulatedFilter: boolean?): ErrorSummary
	local count = 0
	local sum = 0
	local maxErr: number? = nil
	local lastErr: number? = nil

	for _, s in ipairs(self.samples) do
		local matchId = (targetId == nil or s.targetId == targetId)
		local matchSim = (simulatedFilter == nil or s.simulated == simulatedFilter)
		if matchId and matchSim then
			count += 1
			sum += s.errorStuds
			lastErr = s.errorStuds
			if maxErr == nil or s.errorStuds > maxErr then
				maxErr = s.errorStuds
			end
		end
	end

	if count == 0 then
		return { count = 0, lastError = nil, meanError = nil, maxError = nil }
	end

	return {
		count = count,
		lastError = lastErr,
		meanError = sum / count,
		maxError = maxErr,
	}
end


