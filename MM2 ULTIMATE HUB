local AimSystem = {}
AimSystem.__index = AimSystem

function AimSystem.new(getConfig: () -> HubConfig)
	return setmetatable({
		_getConfig = getConfig,
		_lockedCharacter = nil :: Model?,
	}, AimSystem)
end

function AimSystem:GetClosestCharacter(): Model?
	local cfg: HubConfig = self._getConfig()
	local localPlayer = Players.LocalPlayer
	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return nil
	end

	if cfg.TargetLock and self._lockedCharacter and self._lockedCharacter.Parent then
		local lockHum = self._lockedCharacter:FindFirstChildOfClass("Humanoid")
		local lockRoot = self._lockedCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?
		if lockHum and lockHum.Health > 0 and lockRoot then
			return self._lockedCharacter
		end
	end
	self._lockedCharacter = nil

	local closestChar: Model? = nil
	local shortestDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == localPlayer then
			continue
		end
		if cfg.TeamCheck and localPlayer.Team and plr.Team and localPlayer.Team == plr.Team then
			continue
		end
		local targetChar = plr.Character
		if not targetChar or targetChar == character then
			continue
		end
		local targetRoot = targetChar:FindFirstChild("HumanoidRootPart") :: BasePart?
		local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
		if not targetRoot or not targetHum or targetHum.Health <= 0 then
			continue
		end
		local dist = (hrp.Position - targetRoot.Position).Magnitude
		if dist < shortestDist then
			shortestDist = dist
			closestChar = targetChar
		end
	end

	if cfg.TargetLock and closestChar then
		self._lockedCharacter = closestChar
	end
	return closestChar
end

function AimSystem:GetTargetPart(character: Model?): BasePart?
	if not character then
		return nil
	end
	local cfg: HubConfig = self._getConfig()
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	local part = character:FindFirstChild(cfg.TargetPart)
	if part and part:IsA("BasePart") then
		return part
	end
	local fallback = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	return if fallback and fallback:IsA("BasePart") then fallback else nil
end

function AimSystem:ComputePredictedDirection(origin: Vector3, direction: Vector3): Vector3
	local cfg: HubConfig = self._getConfig()
	if not cfg.EnableAimAssist then
		return direction
	end
	local targetChar = self:GetClosestCharacter()
	local targetPart = self:GetTargetPart(targetChar)
	if not targetPart then
		return direction
	end
	local predictedPos = targetPart.Position + (targetPart.AssemblyLinearVelocity * math.max(0, cfg.Prediction))
	local magnitude = direction.Magnitude
	if magnitude <= 0 then
		return direction
	end
	local rawDir = predictedPos - origin
	if rawDir.Magnitude <= 0 then
		return direction
	end
	local smoothAlpha = math.clamp(1 - cfg.Smoothness, 0.05, 1)
	return direction.Unit:Lerp(rawDir.Unit, smoothAlpha).Unit * magnitude
end

function AimSystem:GetStatusSummary(): string
	local targetChar = self:GetClosestCharacter()
	if not targetChar then
		return "Sin objetivo cercano"
	end
	local part = self:GetTargetPart(targetChar)
	local plr = Players:GetPlayerFromCharacter(targetChar)
	local name = if plr then plr.Name else targetChar.Name
	local partName = if part then part.Name else "N/A"
	return string.format("%s (%s)", name, partName)
end

local VisualsSystem = {}
VisualsSystem.__index = VisualsSystem

local ACCENT_MAP: { [string]: Color3 } = {
	["Pastel Blue"] = Color3.fromRGB(132, 186, 255),
	["Lilac Slate"] = Color3.fromRGB(158, 164, 246),
	["Sky Cyan"] = Color3.fromRGB(122, 212, 238),
	["Soft Amber"] = Color3.fromRGB(242, 196, 118),
}

local function detectRole(plr: Player): string
	local char = plr.Character
	local backpack = plr:FindFirstChildOfClass("Backpack")
	if (char and char:FindFirstChild("Knife")) or (backpack and backpack:FindFirstChild("Knife")) then
		return "Murderer"
	end
	if (char and char:FindFirstChild("Gun")) or (backpack and backpack:FindFirstChild("Gun")) then
		return "Sheriff"
	end
	return "Innocent"
end

local function getRoleColor(role: string, fallbackColor: Color3): Color3
	if role == "Murderer" then
		return Color3.fromRGB(235, 87, 87)
	elseif role == "Sheriff" then
		return Color3.fromRGB(120, 178, 255)
	end
	return fallbackColor
end

local function getAnchorPart(char: Model): BasePart?
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function VisualsSystem.new(getConfig: () -> HubConfig)
	return setmetatable({
		_getConfig = getConfig,
		_entries = {} :: { [Player]: { Highlight: Highlight?, Billboard: BillboardGui?, Label: TextLabel? } },
		_gunEntries = {} :: { [BasePart]: { Billboard: BillboardGui, Label: TextLabel } },
		_connStep = nil :: RBXScriptConnection?,
		_connPlayerRemoving = nil :: RBXScriptConnection?,
		_accum = 0,
		_destroyed = false,
	}, VisualsSystem)
end

function VisualsSystem:_clearPlayerVisual(plr: Player)
	local entry = self._entries[plr]
	if entry then
		if entry.Highlight then
			entry.Highlight:Destroy()
		end
		if entry.Billboard then
			entry.Billboard:Destroy()
		end
		self._entries[plr] = nil
	end
end

function VisualsSystem:_clearAllVisuals()
	for plr in pairs(self._entries) do
		self:_clearPlayerVisual(plr)
	end
	for part, gEntry in pairs(self._gunEntries) do
		if gEntry.Billboard then
			gEntry.Billboard:Destroy()
		end
		self._gunEntries[part] = nil
	end
end

function VisualsSystem:_ensurePlayerEntry(plr: Player, adorneeChar: Model)
	local entry = self._entries[plr]
	if not entry then
		entry = { Highlight = nil, Billboard = nil, Label = nil }
		self._entries[plr] = entry
	end
	if entry.Highlight and entry.Highlight.Adornee ~= adorneeChar then
		entry.Highlight:Destroy()
		entry.Highlight = nil
	end
	local anchor = getAnchorPart(adorneeChar)
	if entry.Billboard and anchor and entry.Billboard.Adornee ~= anchor then
		entry.Billboard:Destroy()
		entry.Billboard = nil
		entry.Label = nil
	end
	return entry
end

function VisualsSystem:_updatePlayers(cfg: HubConfig)
	local localPlayer = Players.LocalPlayer
	local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local accentColor = ACCENT_MAP[cfg.ESPAccentColor] or Color3.fromRGB(132, 186, 255)

	if not cfg.PlayerESP then
		for plr in pairs(self._entries) do
			self:_clearPlayerVisual(plr)
		end
		return
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == localPlayer then
			self:_clearPlayerVisual(plr)
			continue
		end
		local char = plr.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not char or not root or not hum or hum.Health <= 0 then
			self:_clearPlayerVisual(plr)
			continue
		end
		local dist = if localRoot then math.floor((localRoot.Position - root.Position).Magnitude) else 0
		if dist > cfg.ESPDistance then
			self:_clearPlayerVisual(plr)
			continue
		end

		local role = detectRole(plr)
		local showRole = cfg.RoleIndicators
			or (role == "Murderer" and cfg.MurdererIndicator)
			or (role == "Sheriff" and cfg.SheriffIndicator)
		local color = if showRole then getRoleColor(role, accentColor) else accentColor
		local entry = self:_ensurePlayerEntry(plr, char)

		if cfg.HighlightPlayers then
			if not entry.Highlight then
				local hl = Instance.new("Highlight")
				hl.Name = "MM2Hub_Highlight"
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.FillTransparency = 0.65
				hl.OutlineTransparency = 0.15
				hl.Parent = char
				hl.Adornee = char
				entry.Highlight = hl
			end
			entry.Highlight.FillColor = color
			entry.Highlight.OutlineColor = color
		elseif entry.Highlight then
			entry.Highlight:Destroy()
			entry.Highlight = nil
		end

		local partsText: { string } = {}
		if cfg.NameESP then
			table.insert(partsText, plr.Name)
		end
		if showRole then
			table.insert(partsText, "[" .. role .. "]")
		end
		if cfg.DistanceESP and localRoot then
			table.insert(partsText, tostring(dist) .. " st")
		end

		local anchor = getAnchorPart(char)
		if #partsText > 0 and anchor then
			if not entry.Billboard then
				local bg = Instance.new("BillboardGui")
				bg.Name = "MM2Hub_Tag"
				bg.Size = UDim2.new(0, 150, 0, 22)
				bg.StudsOffset = Vector3.new(0, 2.2, 0)
				bg.AlwaysOnTop = true
				bg.Parent = anchor
				bg.Adornee = anchor

				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(1, 0, 1, 0)
				lbl.BackgroundTransparency = 1
				lbl.Font = Enum.Font.GothamBold
				lbl.TextSize = 11
				lbl.TextStrokeTransparency = 0.35
				lbl.Parent = bg

				entry.Billboard = bg
				entry.Label = lbl
			end
			if entry.Label then
				entry.Label.Text = table.concat(partsText, " • ")
				entry.Label.TextColor3 = color
			end
		elseif entry.Billboard then
			entry.Billboard:Destroy()
			entry.Billboard = nil
			entry.Label = nil
		end
	end

	for plr in pairs(self._entries) do
		if not plr.Parent then
			self:_clearPlayerVisual(plr)
		end
	end
end

function VisualsSystem:_updateDroppedGuns(cfg: HubConfig)
	local active: { [BasePart]: boolean } = {}
	if cfg.PlayerESP and cfg.DroppedGunIndicator then
		local localRoot = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj.Name == "GunDrop" and obj:IsA("BasePart") then
				local dist = if localRoot then math.floor((localRoot.Position - obj.Position).Magnitude) else 0
				if dist <= cfg.ESPDistance then
					active[obj] = true
					local gEntry = self._gunEntries[obj]
					if not gEntry then
						local bg = Instance.new("BillboardGui")
						bg.Name = "MM2Hub_GunTag"
						bg.Size = UDim2.new(0, 120, 0, 20)
						bg.StudsOffset = Vector3.new(0, 1.4, 0)
						bg.AlwaysOnTop = true
						bg.Parent = obj
						bg.Adornee = obj

						local lbl = Instance.new("TextLabel")
						lbl.Size = UDim2.new(1, 0, 1, 0)
						lbl.BackgroundTransparency = 1
						lbl.Font = Enum.Font.GothamBold
						lbl.TextSize = 11
						lbl.TextStrokeTransparency = 0.35
						lbl.TextColor3 = Color3.fromRGB(122, 214, 178)
						lbl.Parent = bg

						gEntry = { Billboard = bg, Label = lbl }
						self._gunEntries[obj] = gEntry
					end
					gEntry.Label.Text = "GunDrop • " .. tostring(dist) .. " st"
				end
			end
		end
	end
	for part, gEntry in pairs(self._gunEntries) do
		if not active[part] or not part.Parent then
			if gEntry.Billboard then
				gEntry.Billboard:Destroy()
			end
			self._gunEntries[part] = nil
		end
	end
end

function VisualsSystem:Refresh()
	if self._destroyed then
		return
	end
	local cfg: HubConfig = self._getConfig()
	self:_updatePlayers(cfg)
	self:_updateDroppedGuns(cfg)
end

function VisualsSystem:Start()
	if self._destroyed or self._connStep then
		return
	end
	self._connPlayerRemoving = Players.PlayerRemoving:Connect(function(plr: Player)
		self:_clearPlayerVisual(plr)
	end)
	self._connStep = RunService.Heartbeat:Connect(function(dt: number)
		if self._destroyed then
			return
		end
		local cfg: HubConfig = self._getConfig()
		local interval = if cfg.PerformanceMode then 0.25 else 0.1
		self._accum += dt
		if self._accum >= interval then
			self._accum = 0
			self:_updatePlayers(cfg)
			self:_updateDroppedGuns(cfg)
		end
	end)
	self:Refresh()
end

function VisualsSystem:Stop()
	if self._connStep then
		self._connStep:Disconnect()
		self._connStep = nil
	end
	if self._connPlayerRemoving then
		self._connPlayerRemoving:Disconnect()
		self._connPlayerRemoving = nil
	end
	self:_clearAllVisuals()
end

function VisualsSystem:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self:Stop()
end

