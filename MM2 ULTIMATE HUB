function UIController:UpdateScale(viewportSize: Vector2)
	if viewportSize.Y <= 0 then
		return
	end
	local scale = math.clamp(viewportSize.Y / 760, 0.72, 1.15)
	if viewportSize.X < 650 then
		scale = math.clamp(viewportSize.X / 580, 0.65, 1.0)
	end
	self.uiScale.Scale = scale
end

function UIController:UpdateTelemetry(t: LiveTelemetry)
	local meanStr = if t.meanErrorStuds then string.format("%.2f st", t.meanErrorStuds) else "--"
	local maxStr = if t.maxErrorStuds then string.format("%.2f st", t.maxErrorStuds) else "--"
	local lastStr = if t.lastErrorStuds then string.format("%.2f st", t.lastErrorStuds) else "--"

	self.dashSummaryLbl.Text = string.format("FPS: %.0f | Ronda: %s | Filtro: %s", t.fps, t.roundPhase, t.filterName)
	self.dashTargetLbl.Text = string.format("Objetivo: %s (%s) | Dist.: %.1f st", t.targetName, t.targetRole, t.worldDistStuds)
	self.dashMetricsLbl.Text = string.format("Error prom.: %s | Máx.: %s", meanStr, maxStr)

	self.fovInfoLbl.Text = string.format("FOV efectivo: %.0f px | Dist. mira: %.0f px", t.fovRadiusPx, t.screenDistPx)
	self.predVelLbl.Text = string.format("Vel.: %.1f st/s | Acel.: %.1f st/s²", t.speedStudsPerSec, t.accelStudsPerSec2)
	self.predTimeLbl.Text = string.format("t_pred: %.3f s | Offset: %.2f studs", t.predTimeSec, t.offsetStuds)

	self.visRoundLbl.Text = string.format("Fase: %s | Tiempo: %.1f s", t.roundPhase, t.roundTimerSec)
	self.statsMainLbl.Text = string.format("Muestras: %d | Error prom.: %s", t.sampleCount, meanStr)
	self.statsExtLbl.Text = string.format("Último error: %s | Error máx.: %s", lastStr, maxStr)
	self.debugLogLbl.Text = "Log: " .. t.statusLog
end


