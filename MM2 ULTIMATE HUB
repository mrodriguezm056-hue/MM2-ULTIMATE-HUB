local function resolveAnchorPart(model: Model): BasePart?
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			return d
		end
	end
	return nil
end

local function isAlive(model: Model): boolean
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return true
	end
	return hum.Health > 0
end

function EntityManager:Refresh(includeLocalCharacter: boolean?): { TrackedEntity }
	table.clear(self.entities)
	local localChar = self.localPlayer.Character

	if includeLocalCharacter and localChar and localChar.Parent and isAlive(localChar) then
		local anchor = resolveAnchorPart(localChar)
		if anchor then
			table.insert(self.entities, {
				id = self.localPlayer.Name,
				model = localChar,
				anchorPart = anchor,
				isDummy = false,
			})
		end
	end

	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Model") and child ~= localChar and child.Parent and isAlive(child) then
			local hum = child:FindFirstChildOfClass("Humanoid")
			local isPlayerChar = false
			if hum then
				for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
					if plr.Character == child then
						isPlayerChar = true
						break
					end
				end
			end

			local anchor = resolveAnchorPart(child)
			if anchor then
				table.insert(self.entities, {
					id = child.Name,
					model = child,
					anchorPart = anchor,
					isDummy = not isPlayerChar,
				})
			end
		end
	end

	return self.entities
end

function EntityManager:GetEntities(): { TrackedEntity }
	return self.entities
end

function EntityManager:GetSelectorCandidates(): { { id: string, model: Model, part: BasePart } }
	local out = {}
	for _, ent in ipairs(self.entities) do
		table.insert(out, {
			id = ent.id,
			model = ent.model,
			part = ent.anchorPart,
		})
	end
	return out
end

function EntityManager:GetVisualEntities(): { { id: string, model: Model } }
	local out = {}
	for _, ent in ipairs(self.entities) do
		table.insert(out, {
			id = ent.id,
			model = ent.model,
		})
	end
	return out
end


