export type AxisWeightsData = {
	X: number,
	Y: number,
	Z: number,
}

export type SuiteSettings = {
	AutoPrediction: boolean,
	PredictionStrength: number,
	AxisWeights: AxisWeightsData,
	DynamicPrediction: boolean,
	PingCompensation: boolean,
	PingSeconds: number,
	ProjectileSpeed: number,
	MaxPredictionTime: number,
	BaseFovRadiusPx: number,
	ScaleFovByViewport: boolean,
	RequireLineOfSight: boolean,
	VisualsEnabled: boolean,
	SilentAimEnabled: boolean,
	DemoModeEnabled: boolean,
}

type SettingsListener = (settings: SuiteSettings, changedKey: string?) -> ()

local SettingsManager = {}
SettingsManager.__index = SettingsManager

local function isFiniteNum(n: unknown): boolean
	return type(n) == "number" and n == n and math.abs(n) ~= math.huge
end

local function clampNum(val: unknown, fallback: number, minV: number, maxV: number): number
	if not isFiniteNum(val) then
		return fallback
	end
	return math.clamp(val :: number, minV, maxV)
end

function SettingsManager.GetDefaultSettings(): SuiteSettings
	return {
		AutoPrediction = true,
		PredictionStrength = 1.0,
		AxisWeights = { X = 1.0, Y = 0.65, Z = 1.0 },
		DynamicPrediction = true,
		PingCompensation = true,
		PingSeconds = 0.06,
		ProjectileSpeed = 135,
		MaxPredictionTime = 0.85,
		BaseFovRadiusPx = 185,
		ScaleFovByViewport = true,
		RequireLineOfSight = true,
		VisualsEnabled = true,
		SilentAimEnabled = true,
		DemoModeEnabled = true,
	}
end

function SettingsManager.CloneSettings(src: SuiteSettings): SuiteSettings
	return {
		AutoPrediction = src.AutoPrediction == true,
		PredictionStrength = clampNum(src.PredictionStrength, 1.0, 0, 5),
		AxisWeights = {
			X = clampNum(src.AxisWeights.X, 1.0, -5, 5),
			Y = clampNum(src.AxisWeights.Y, 0.65, -5, 5),
			Z = clampNum(src.AxisWeights.Z, 1.0, -5, 5),
		},
		DynamicPrediction = src.DynamicPrediction == true,
		PingCompensation = src.PingCompensation == true,
		PingSeconds = clampNum(src.PingSeconds, 0.06, 0, 2.0),
		ProjectileSpeed = clampNum(src.ProjectileSpeed, 135, 0, 5000),
		MaxPredictionTime = clampNum(src.MaxPredictionTime, 0.85, 0.01, 5.0),
		BaseFovRadiusPx = clampNum(src.BaseFovRadiusPx, 185, 10, 800),
		ScaleFovByViewport = src.ScaleFovByViewport == true,
		RequireLineOfSight = src.RequireLineOfSight == true,
		VisualsEnabled = src.VisualsEnabled == true,
		SilentAimEnabled = src.SilentAimEnabled == true,
		DemoModeEnabled = src.DemoModeEnabled == true,
	}
end

function SettingsManager.new(initial: Partial<SuiteSettings>?): any
	local current = SettingsManager.GetDefaultSettings()
	local self = {
		current = current,
		listeners = {} :: { [number]: SettingsListener },
		nextListenerId = 1,
	}
	setmetatable(self, SettingsManager)

	if initial then
		self:Update(initial)
	end

	return self
end

function SettingsManager:Get(): SuiteSettings
	return SettingsManager.CloneSettings(self.current)
end

function SettingsManager:Subscribe(callback: SettingsListener): () -> ()
	local id = self.nextListenerId
	self.nextListenerId += 1
	self.listeners[id] = callback

	return function()
		self.listeners[id] = nil
	end
end

function SettingsManager:Emit(changedKey: string?)
	local snapshot = self:Get()
	for _, fn in pairs(self.listeners) do
		fn(snapshot, changedKey)
	end
end

function SettingsManager:SetValue(key: string, value: unknown)
	local c = self.current

	if key == "AutoPrediction" and type(value) == "boolean" then
		c.AutoPrediction = value
	elseif key == "PredictionStrength" then
		c.PredictionStrength = clampNum(value, c.PredictionStrength, 0, 5)
	elseif key == "DynamicPrediction" and type(value) == "boolean" then
		c.DynamicPrediction = value
	elseif key == "PingCompensation" and type(value) == "boolean" then
		c.PingCompensation = value
	elseif key == "PingSeconds" then
		c.PingSeconds = clampNum(value, c.PingSeconds, 0, 2.0)
	elseif key == "ProjectileSpeed" then
		c.ProjectileSpeed = clampNum(value, c.ProjectileSpeed, 0, 5000)
	elseif key == "MaxPredictionTime" then
		c.MaxPredictionTime = clampNum(value, c.MaxPredictionTime, 0.01, 5.0)
	elseif key == "BaseFovRadiusPx" then
		c.BaseFovRadiusPx = clampNum(value, c.BaseFovRadiusPx, 10, 800)
	elseif key == "ScaleFovByViewport" and type(value) == "boolean" then
		c.ScaleFovByViewport = value
	elseif key == "RequireLineOfSight" and type(value) == "boolean" then
		c.RequireLineOfSight = value
	elseif key == "VisualsEnabled" and type(value) == "boolean" then
		c.VisualsEnabled = value
	elseif key == "SilentAimEnabled" and type(value) == "boolean" then
		c.SilentAimEnabled = value
	elseif key == "DemoModeEnabled" and type(value) == "boolean" then
		c.DemoModeEnabled = value
	elseif key == "AxisX" then
		c.AxisWeights.X = clampNum(value, c.AxisWeights.X, -5, 5)
	elseif key == "AxisY" then
		c.AxisWeights.Y = clampNum(value, c.AxisWeights.Y, -5, 5)
	elseif key == "AxisZ" then
		c.AxisWeights.Z = clampNum(value, c.AxisWeights.Z, -5, 5)
	else
		return
	end

	self:Emit(key)
end

function SettingsManager:Update(partial: Partial<SuiteSettings>)
	for k, v in pairs(partial) do
		if k == "AxisWeights" and type(v) == "table" then
			if v.X ~= nil then
				self.current.AxisWeights.X = clampNum(v.X, self.current.AxisWeights.X, -5, 5)
			end
			if v.Y ~= nil then
				self.current.AxisWeights.Y = clampNum(v.Y, self.current.AxisWeights.Y, -5, 5)
			end
			if v.Z ~= nil then
				self.current.AxisWeights.Z = clampNum(v.Z, self.current.AxisWeights.Z, -5, 5)
			end
		else
			self:SetValue(k, v)
		end
	end
	self:Emit("BulkUpdate")
end

function SettingsManager:ResetToDefault()
	self.current = SettingsManager.GetDefaultSettings()
	self:Emit("Reset")
end


