-- 3. ReplicatedStorage/TargetSelector (ModuleScript)
-- ============================================================================
export type PriorityMode = "RoleFirst" | "WeightedScore"

export type SelectorConfig = {
	BaseFovRadiusPx: number,
	ScaleFovByViewport: boolean,
	CheckPredictedInFov: boolean,
	RequireLineOfSight: boolean,
	UsePredictedForRay: boolean,
	MaxRayDistance: number,
	PriorityMode: PriorityMode,
	AllowedRoles: { [RoleOrUnknown]: boolean }?,
	RoleWeights: { [RoleOrUnknown]: number },
}

export type CandidateInput = {
	id: string,
	model: Model,
	part: BasePart,
}

export type CandidateResult = {
	targetId: string,
	role: RoleOrUnknown,
	model: Model,
	anchorPart: BasePart,
	currentPos: Vector3,
	predictedPos: Vector3,
	predictedTime: number,
	worldDistance: number,
	screenPos: Vector3,
	screenDistPx: number,
	fovRadiusPx: number,
	roleWeight: number,
	score: number,
	hasLineOfSight: boolean,
	hitInstance: Instance?,
}

local TargetSelector = {}
TargetSelector.__index = TargetSelector

local function isValidPos(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z
		and math.abs(v.X) ~= math.huge and math.abs(v.Y) ~= math.huge and math.abs(v.Z) ~= math.huge
end

function TargetSelector.new(predictionEngine: any, roleVisuals: any?, customConfig: Partial<SelectorConfig>?): any
	local config: SelectorConfig = {
		BaseFovRadiusPx = 180,
		ScaleFovByViewport = true,
		CheckPredictedInFov = false,
		RequireLineOfSight = true,
		UsePredictedForRay = false,
		MaxRayDistance = 250,
		PriorityMode = "RoleFirst",
		AllowedRoles = nil,
		RoleWeights = {
			Murderer = 4.0,
			Sheriff = 3.0,
			Hero = 3.0,
			Innocent = 1.0,
			Unknown = 0.5,
		},
	}

	local self = {
		engine = predictionEngine,
		roleVisuals = roleVisuals,
		config = config,
		rayParams = RaycastParams.new(),
	}

	self.rayParams.FilterType = Enum.RaycastFilterType.Exclude
	self.rayParams.IgnoreWater = true

	setmetatable(self, TargetSelector)

	if customConfig then
		self:SetConfig(customConfig)
	end

	return self
end

function TargetSelector:SetConfig(partial: Partial<SelectorConfig>)
	for k, v in pairs(partial) do
		if k == "RoleWeights" and type(v) == "table" then
			for roleKey, weightVal in pairs(v) do
				if type(weightVal) == "number" and weightVal == weightVal and math.abs(weightVal) ~= math.huge then
					self.config.RoleWeights[roleKey] = weightVal
				end
			end
		else
			(self.config :: any)[k] = v
		end
	end
end

function TargetSelector:GetTargetRole(targetId: string): RoleOrUnknown
	if self.roleVisuals and type(self.roleVisuals.GetRole) == "function" then
		return self.roleVisuals:GetRole(targetId)
	end
	return "Unknown"
end

function TargetSelector:IsRoleAllowed(role: RoleOrUnknown): boolean
	local allowed = self.config.AllowedRoles
	if not allowed then
		return true
	end
	return allowed[role] == true
end

function TargetSelector:GetEffectiveFovRadius(camera: Camera): number
	local cfg: SelectorConfig = self.config
	local baseRadius = math.max(10, cfg.BaseFovRadiusPx)
	local viewportY = camera.ViewportSize.Y
	if viewportY <= 0 then
		return baseRadius
	end
	if cfg.ScaleFovByViewport then
		return baseRadius * (viewportY / 1080)
	end
	return baseRadius
end

function TargetSelector:IsPointInFov(
	camera: Camera,
	worldPos: Vector3,
	refScreenPoint: Vector2,
	fovRadiusPx: number
): (boolean, Vector3, number)
	local screenPos, onScreen = camera:WorldToScreenPoint(worldPos)
	if not onScreen or screenPos.Z <= 0 then
		return false, screenPos, math.huge
	end

	local point2D = Vector2.new(screenPos.X, screenPos.Y)
	local distPx = (point2D - refScreenPoint).Magnitude
	return distPx <= fovRadiusPx, screenPos, distPx
end

function TargetSelector:CheckLineOfSight(
	originPos: Vector3,
	goalPos: Vector3,
	localCharacter: Model?,
	targetModel: Model
): (boolean, Instance?)
	local delta = goalPos - originPos
	local dist = delta.Magnitude
	if dist <= 1e-4 then
		return true, nil
	end

	local filterList: { Instance } = {}
	if localCharacter and localCharacter.Parent then
		table.insert(filterList, localCharacter)
	end
	self.rayParams.FilterDescendantsInstances = filterList

	local result = workspace:Raycast(originPos, delta, self.rayParams)
	if not result then
		return true, nil
	end

	if result.Instance:IsDescendantOf(targetModel) then
		return true, result.Instance
	end

	return false, result.Instance
end

local function isBetterCandidate(mode: PriorityMode, candidate: CandidateResult, currentBest: CandidateResult?): boolean
	if currentBest == nil then
		return true
	end
	if mode == "RoleFirst" then
		if candidate.roleWeight ~= currentBest.roleWeight then
			return candidate.roleWeight > currentBest.roleWeight
		end
		return candidate.screenDistPx < currentBest.screenDistPx
	end
	return candidate.score > currentBest.score
end

local function isAliveHumanoidModel(model: Model): boolean
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return true
	end
	return hum.Health > 0
end

function TargetSelector:SelectBestTarget(
	camera: Camera,
	originPos: Vector3,
	refScreenPoint: Vector2,
	candidates: { CandidateInput },
	localCharacter: Model?,
	now: number?
): CandidateResult?
	if not isValidPos(originPos) then
		return nil
	end

	local t = if type(now) == "number" and now == now then now else os.clock()
	local cfg: SelectorConfig = self.config
	local fovRadius = self:GetEffectiveFovRadius(camera)
	local best: CandidateResult? = nil

	for _, item in ipairs(candidates) do
		local model = item.model
		local part = item.part
		if model and model.Parent and part and part.Parent and isAliveHumanoidModel(model) then
			local currentPos = part.Position
			if isValidPos(currentPos) then
				local role = self:GetTargetRole(item.id)
				if self:IsRoleAllowed(role) then
					local worldDist = (currentPos - originPos).Magnitude
					if worldDist <= cfg.MaxRayDistance then
						local inFovCurrent, screenPos, distPx = self:IsPointInFov(
							camera,
							currentPos,
							refScreenPoint,
							fovRadius
						)

						if inFovCurrent then
							local predPos, predTime, _, predInfo = self.engine:Predict(item.id, originPos, currentPos, t)
							if not isValidPos(predPos) then
								predPos = currentPos
							end

							local inFovPred = true
							if cfg.CheckPredictedInFov then
								inFovPred = self:IsPointInFov(camera, predPos, refScreenPoint, fovRadius)
							end

							if inFovPred then
								local rayGoal = if cfg.UsePredictedForRay then predPos else currentPos
								local losOk, hitInst = self:CheckLineOfSight(originPos, rayGoal, localCharacter, model)
								if (not cfg.RequireLineOfSight) or losOk then
									local weight = cfg.RoleWeights[role] or 1.0
									local proximity = math.clamp(1 - (distPx / math.max(fovRadius, 1)), 0, 1)
									local speedBonus = math.clamp(predInfo.velocity.Magnitude / 40, 0, 0.25)
									local combinedScore = weight * (0.4 + 0.6 * proximity + speedBonus)

									local candidate: CandidateResult = {
										targetId = item.id,
										role = role,
										model = model,
										anchorPart = part,
										currentPos = currentPos,
										predictedPos = predPos,
										predictedTime = predTime,
										worldDistance = worldDist,
										screenPos = screenPos,
										screenDistPx = distPx,
										fovRadiusPx = fovRadius,
										roleWeight = weight,
										score = combinedScore,
										hasLineOfSight = losOk,
										hitInstance = hitInst,
									}

									if isBetterCandidate(cfg.PriorityMode, candidate, best) then
										best = candidate
									end
								end
							end
						end
					end
				end
			end
		end
	end

	return best
end


