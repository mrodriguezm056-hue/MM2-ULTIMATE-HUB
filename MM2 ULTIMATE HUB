end

function SilentAimController:SetDemoMode(state: boolean)
	self.demoMode = state == true
end

function SilentAimController:IsDemoMode(): boolean
	return self.demoMode
end

function SilentAimController:ResolveAim(
	camera: Camera,
	originPos: Vector3,
	fallbackDirection: Vector3,
	refScreenPoint: Vector2,
	candidates: { { id: string, model: Model, part: BasePart } },
	localCharacter: Model?,
	now: number?
): AimResult
	local safeFallbackDir = if fallbackDirection.Magnitude > 1e-5
		then fallbackDirection.Unit
		else camera.CFrame.LookVector

	local fovRadius = self.selector:GetEffectiveFovRadius(camera)
	local fallbackPoint = originPos + safeFallbackDir * 100

	if not self.enabled then
		return {
			hasTarget = false,
			currentPos = fallbackPoint,
			aimPoint = fallbackPoint,
			direction = safeFallbackDir,
			offsetStuds = 0,
			worldDistance = 100,
			targetId = nil,
			targetModel = nil,
			role = nil,
			predictedTime = 0,
			screenDistPx = math.huge,
			fovRadiusPx = fovRadius,
			demoMode = self.demoMode,
		}
	end

	local best = self.selector:SelectBestTarget(
		camera,
		originPos,
		refScreenPoint,
		candidates,
		localCharacter,
		now
	)

	if best then
		local delta = best.predictedPos - originPos
		local dir = if delta.Magnitude > 1e-4 then delta.Unit else safeFallbackDir
		return {
			hasTarget = true,
			currentPos = best.currentPos,
			aimPoint = best.predictedPos,
			direction = dir,
			offsetStuds = (best.predictedPos - best.currentPos).Magnitude,
			worldDistance = best.worldDistance,
			targetId = best.targetId,
			targetModel = best.model,
			role = best.role,
			predictedTime = best.predictedTime,
			screenDistPx = best.screenDistPx,
			fovRadiusPx = best.fovRadiusPx,
			demoMode = self.demoMode,
		}
	end

	return {
		hasTarget = false,
		currentPos = fallbackPoint,
		aimPoint = fallbackPoint,
		direction = safeFallbackDir,
		offsetStuds = 0,
		worldDistance = 100,
		targetId = nil,
		targetModel = nil,
		role = nil,
		predictedTime = 0,
		screenDistPx = math.huge,
		fovRadiusPx = fovRadius,
		demoMode = self.demoMode,
	}
end


