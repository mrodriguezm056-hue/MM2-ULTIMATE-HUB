local ThemeManager = {}
ThemeManager.__index = ThemeManager

function ThemeManager.new(initialTheme: ThemePreset?, initialTransparency: number?, initialSpeed: number?)
	return setmetatable({
		CurrentTheme = initialTheme or "PastelBlue",
		Transparency = math.clamp(initialTransparency or 0.06, 0, 0.45),
		AnimationSpeed = math.clamp(initialSpeed or 1, 0.4, 2.5),
		Listeners = {} :: { (Palette, number, number) -> () },
	}, ThemeManager)
end

function ThemeManager:GetPalette(): Palette
	return PALETTES[self.CurrentTheme] or PALETTES.PastelBlue
end

function ThemeManager:GetTweenInfo(baseDuration: number?, style: Enum.EasingStyle?): TweenInfo
	local duration = math.max(0.05, (baseDuration or 0.2) / self.AnimationSpeed)
	return TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
end

function ThemeManager:Tween(instance: Instance, props: { [string]: any }, duration: number?): Tween
	local tween = TweenService:Create(instance, self:GetTweenInfo(duration), props)
	tween:Play()
	return tween
end

function ThemeManager:OnChanged(callback: (Palette, number, number) -> ())
	table.insert(self.Listeners, callback)
	local idx = #self.Listeners
	callback(self:GetPalette(), self.Transparency, self.AnimationSpeed)
	return {
		Disconnect = function()
			table.remove(self.Listeners, idx)
		end,
	}
end

function ThemeManager:SetAppearance(theme: ThemePreset?, transparency: number?, speed: number?)
	if theme and PALETTES[theme] then
		self.CurrentTheme = theme
	end
	if transparency ~= nil then
		self.Transparency = math.clamp(transparency, 0, 0.45)
	end
	if speed ~= nil then
		self.AnimationSpeed = math.clamp(speed, 0.4, 2.5)
	end
	local palette = self:GetPalette()
	for _, fn in ipairs(self.Listeners) do
		fn(palette, self.Transparency, self.AnimationSpeed)
	end
end

