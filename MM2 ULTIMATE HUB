	end
	self._active = true
	self._connCharAdded = Players.LocalPlayer.CharacterAdded:Connect(function()
		if self._active and not self._destroyed then
			task.defer(function()
				self:ApplyNow()
			end)
		end
	end)
	self._connCamChanged = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		if self._active and not self._destroyed then
			self:ApplyNow()
		end
	end)
	self:ApplyNow()
end

function PlayerSystem:Stop()
	self._active = false
	if self._connCharAdded then
		self._connCharAdded:Disconnect()
		self._connCharAdded = nil
	end
	if self._connCamChanged then
		self._connCamChanged:Disconnect()
		self._connCamChanged = nil
	end
	self:_applyValues(16, 50, 70)
end

function PlayerSystem:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self:Stop()
	table.clear(self._callbacks)
end

export type RoundSnapshot = {
	CurrentMap: string,
	CurrentRole: string,
	RoundTimer: string,
	AlivePlayersText: string,
	MurdererInfo: string,
	SheriffInfo: string,
	DroppedWeaponInfo: string,
	RoundStatsText: string,
}

local RoundSystem = {}
RoundSystem.__index = RoundSystem

function RoundSystem.new()
	return setmetatable({
		_listeners = {} :: { (RoundSnapshot) -> () },
		_connStep = nil :: RBXScriptConnection?,
		_accum = 0,
		_destroyed = false,
	}, RoundSystem)
end

function RoundSystem:GetSnapshot(): RoundSnapshot
	local allPlayers = Players:GetPlayers()
	local totalCount = #allPlayers
	local aliveCount = 0
	local murderers: { string } = {}
	local sheriffs: { string } = {}
	local localRole = detectRole(Players.LocalPlayer)

	for _, plr in ipairs(allPlayers) do
		local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			aliveCount += 1
		end
		local role = detectRole(plr)
		if role == "Murderer" then
			table.insert(murderers, plr.Name)
		elseif role == "Sheriff" then
			table.insert(sheriffs, plr.Name)
		end
	end

	local droppedText = "No caída / En posesión"
	local root = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc.Name == "GunDrop" and desc:IsA("BasePart") then
			droppedText = if root
				then string.format("Caída (%d st)", math.floor((root.Position - desc.Position).Magnitude))
				else "Caída en escenario"
			break
		end
	end

	local attrMap = Workspace:GetAttribute("Map") or Workspace:GetAttribute("CurrentMap")
	local mapText = if type(attrMap) == "string" and attrMap ~= "" then attrMap else "No expuesto en cliente"

	local attrTimer = Workspace:GetAttribute("Timer") or Workspace:GetAttribute("RoundTimer")
	local timerText = "No expuesto en cliente"
	if type(attrTimer) == "number" then
		local sec = math.max(0, math.floor(attrTimer))
		timerText = string.format("%02d:%02d", math.floor(sec / 60), sec % 60)
	elseif type(attrTimer) == "string" and attrTimer ~= "" then
		timerText = attrTimer
	end

	return {
		CurrentMap = mapText,
		CurrentRole = localRole,
		RoundTimer = timerText,
		AlivePlayersText = string.format("%d / %d", aliveCount, totalCount),
		MurdererInfo = if #murderers > 0 then table.concat(murderers, ", ") else "No visible en inventario/personaje",
		SheriffInfo = if #sheriffs > 0 then table.concat(sheriffs, ", ") else "No visible en inventario/personaje",
		DroppedWeaponInfo = droppedText,
		RoundStatsText = string.format("Vivos: %d/%d | Murderers: %d | Sheriffs: %d", aliveCount, totalCount, #murderers, #sheriffs),
	}
end

function RoundSystem:OnUpdated(callback: (RoundSnapshot) -> ())
	table.insert(self._listeners, callback)
	local idx = #self._listeners
	callback(self:GetSnapshot())
	return {
		Disconnect = function()
			table.remove(self._listeners, idx)
		end,
	}
end

function RoundSystem:_emit()
	if self._destroyed then
		return
	end
	local snap = self:GetSnapshot()
	for _, fn in ipairs(self._listeners) do
		fn(snap)
	end
end

function RoundSystem:Start()
	if self._destroyed or self._connStep then
		return
	end
	self:_emit()
	self._connStep = RunService.Heartbeat:Connect(function(dt: number)
		if self._destroyed then
			return
		end
		self._accum += dt
		if self._accum >= 0.4 then
			self._accum = 0
			self:_emit()
		end
	end)
end

function RoundSystem:Stop()
	if self._connStep then
		self._connStep:Disconnect()
		self._connStep = nil
	end
end

function RoundSystem:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self:Stop()
	table.clear(self._listeners)
end

