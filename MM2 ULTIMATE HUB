		Controls.CreateDropdown(page, "Color Settings", { "Pastel Blue", "Lilac Slate", "Sky Cyan", "Soft Amber" }, d.ESPAccentColor, theme, function(opt)
			cfgMgr:SetValue("ESPAccentColor", opt)
			visualsSystem:Refresh()
		end)
	end

	-- Pestaña: Player
	do
		local page = pages.Player
		local d = cfgMgr.Data
		Controls.CreateSectionHeader(page, "Character Readouts", theme)
		local _, setWSDisplay = Controls.CreateInfoRow(page, "WalkSpeed Display", tostring(d.WalkSpeedValue), theme)
		local _, setJPDisplay = Controls.CreateInfoRow(page, "JumpPower Display", tostring(d.JumpPowerValue), theme)
		local _, setCharInfo = Controls.CreateInfoRow(page, "Character Information", playerSystem:GetCharacterName(), theme)

		Controls.CreateSectionHeader(page, "Movement & Camera Values", theme)
		local _, setWSSlider = Controls.CreateSlider(page, "Movement Settings — WalkSpeed", 8, 50, 1, d.WalkSpeedValue, "", theme, function(val)
			cfgMgr:SetValue("WalkSpeedValue", val)
			setWSDisplay(tostring(val))
			playerSystem:ApplyNow()
		end)
		local _, setJPSlider = Controls.CreateSlider(page, "Movement Settings — JumpPower", 20, 120, 1, d.JumpPowerValue, "", theme, function(val)
			cfgMgr:SetValue("JumpPowerValue", val)
			setJPDisplay(tostring(val))
			playerSystem:ApplyNow()
		end)
		local _, setFOVSlider = Controls.CreateSlider(page, "Field of View", 50, 110, 1, d.FieldOfViewValue, "°", theme, function(val)
			cfgMgr:SetValue("FieldOfViewValue", val)
			playerSystem:ApplyNow()
		end)

		Controls.CreateActionButton(page, "Reset Character Settings", true, theme, function()
			cfgMgr:SetValue("WalkSpeedValue", 16)
			cfgMgr:SetValue("JumpPowerValue", 50)
			cfgMgr:SetValue("FieldOfViewValue", 70)
			setWSSlider(16)
			setJPSlider(50)
			setFOVSlider(70)
			setWSDisplay("16")
			setJPDisplay("50")
			playerSystem:ResetToDefaults()
			setCharInfo(playerSystem:GetCharacterName())
			notifier:Notify({ Title = "Player", Message = "Valores restablecidos a 16 / 50 / 70°.", Kind = "Success" })
		end)

		playerSystem:OnCharacterChanged(function(charName: string)
			setCharInfo(charName)
		end)
	end

	-- Pestaña: Round
	do
		local page = pages.Round
		Controls.CreateSectionHeader(page, "Round Information", theme)
		local _, setMap = Controls.CreateInfoRow(page, "Current Map", "—", theme)
		local _, setRole = Controls.CreateInfoRow(page, "Current Role", "—", theme)
		local _, setTimer = Controls.CreateInfoRow(page, "Round Timer", "--:--", theme)
		local _, setAlive = Controls.CreateInfoRow(page, "Alive Players", "0 / 0", theme)

		Controls.CreateSectionHeader(page, "Legitimate Role & Weapon Readouts", theme)
		local _, setMurderer = Controls.CreateInfoRow(page, "Murderer Information", "—", theme)
		local _, setSheriff = Controls.CreateInfoRow(page, "Sheriff Information", "—", theme)
		local _, setDropped = Controls.CreateInfoRow(page, "Dropped Weapon Information", "—", theme)
		local _, setStats = Controls.CreateInfoRow(page, "Round Statistics", "—", theme)

		roundSystem:OnUpdated(function(snap: RoundSnapshot)
			setMap(snap.CurrentMap)
			setRole(snap.CurrentRole)
			setTimer(snap.RoundTimer)
			setAlive(snap.AlivePlayersText)
			setMurderer(snap.MurdererInfo)
			setSheriff(snap.SheriffInfo)
			setDropped(snap.DroppedWeaponInfo)
			setStats(snap.RoundStatsText)
		end)
	end

	-- Pestaña: Inventory (solo lectura)
	do
		local page = pages.Inventory
		Controls.CreateSectionHeader(page, "Inventory Viewer (Read-Only)", theme)
		local _, setFilterStatus = Controls.CreateInfoRow(page, "Item Search Filter", "Ninguno", theme)
		Controls.CreateSearchBox(page, "Buscar cuchillo, arma o rareza...", theme, function(query: string)
			setFilterStatus(if query == "" then "Ninguno" else query)
		end)
		Controls.CreateInfoRow(page, "Knife Information", "Sin datos cargados", theme)
		Controls.CreateInfoRow(page, "Gun Information", "Sin datos cargados", theme)
		Controls.CreateInfoRow(page, "Equipped Items", "Ninguno mostrado", theme)
		Controls.CreateInfoRow(page, "Owned Skins", "0 visibles", theme)
		Controls.CreateInfoRow(page, "Item Rarity", "—", theme)
		Controls.CreateInfoRow(page, "Inventory Statistics", "Modo solo lectura", theme)
	end

	-- Pestaña: Misc
	do
		local page = pages.Misc
		local sessionStart = os.clock()
		Controls.CreateSectionHeader(page, "Performance & Session Telemetry", theme)
		local _, setFPS = Controls.CreateInfoRow(page, "FPS Display", "Calculando...", theme)
		local _, setPing = Controls.CreateInfoRow(page, "Ping Display", "No disponible sin métrica de red", theme)
		Controls.CreateInfoRow(page, "Server Information", "PlaceId: " .. tostring(game.PlaceId), theme)
		local _, setPlayersCount = Controls.CreateInfoRow(page, "Player Counter", tostring(#Players:GetPlayers()), theme)
		local _, setSessionTimer = Controls.CreateInfoRow(page, "Session Timer", "00:00", theme)

		Controls.CreateSectionHeader(page, "Interface & Session Controls", theme)
		Controls.CreateToggle(page, "UI Sounds", "Habilita feedback sonoro de interfaz", cfgMgr.Data.UISounds, theme, function(v)
			cfgMgr:SetValue("UISounds", v)
		end)
		Controls.CreateToggle(page, "Notifications", "Muestra avisos flotantes en pantalla", cfgMgr.Data.NotificationsEnabled, theme, function(v)
			cfgMgr:SetValue("NotificationsEnabled", v)
		end)
		Controls.CreateToggle(page, "Performance Mode", "Reduce intervalo de actualización visual", cfgMgr.Data.PerformanceMode, theme, function(v)
			cfgMgr:SetValue("PerformanceMode", v)
			visualsSystem:Refresh()
		end)
		Controls.CreateActionButton(page, "Copy Server ID", false, theme, function()
			local jobId = if game.JobId ~= "" then game.JobId else "Studio/Local"
			if setclipboard then
				pcall(setclipboard, jobId)
				notifier:Notify({ Title = "Server ID", Message = "Copiado: " .. jobId, Kind = "Success" })
			else
				notifier:Notify({ Title = "Server ID", Message = "JobId: " .. jobId, Kind = "Info" })
			end
		end)
		Controls.CreateActionButton(page, "Rejoin Button", true, theme, function()
			Controls.ShowConfirmModal(modalLayer, "Reconectar al servidor", "¿Deseas intentar reconectarte a esta experiencia ahora?", "Rejoin", theme, function()
				local ok, err = pcall(function()
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, localPlayer)
				end)
				if not ok then
					notifier:Notify({ Title = "Rejoin", Message = "Error al reconectar: " .. tostring(err), Kind = "Warning" })
				end
			end)
		end)

		local accum = 0
		local frames = 0
		RunService.Heartbeat:Connect(function(dt: number)
			if not screenGui.Parent then
				return
			end
			accum += dt
			frames += 1
			if accum >= 0.5 then
				setFPS(tostring(math.floor((frames / accum) + 0.5)) .. " FPS")
				setPlayersCount(tostring(#Players:GetPlayers()))
				local elapsed = math.floor(os.clock() - sessionStart)
				setSessionTimer(string.format("%02d:%02d", math.floor(elapsed / 60), elapsed % 60))
				accum = 0
				frames = 0
			end
		end)
	end

	-- Pestaña: Settings
	do
		local page = pages.Settings
		local d = cfgMgr.Data
		Controls.CreateSectionHeader(page, "Appearance & Layout", theme)
		Controls.CreateDropdown(page, "Theme Selector", { "PastelBlue", "LilacSlate", "DeepOcean" }, d.Theme, theme, function(opt)
			cfgMgr:SetValue("Theme", opt)
		end)
		Controls.CreateSlider(page, "Interface Scale", 0.75, 1.35, 0.05, d.InterfaceScale, "x", theme, function(val)
			cfgMgr:SetValue("InterfaceScale", val)
		end)
		Controls.CreateSlider(page, "Interface Transparency", 0, 0.4, 0.02, d.InterfaceTransparency, "", theme, function(val)
			cfgMgr:SetValue("InterfaceTransparency", val)
		end)
		Controls.CreateSlider(page, "Animation Speed", 0.5, 2.0, 0.1, d.AnimationSpeed, "x", theme, function(val)
			cfgMgr:SetValue("AnimationSpeed", val)
		end)
		Controls.CreateDropdown(page, "UI Position", { "Center", "TopLeft", "BottomRight" }, d.UIPositionPreset, theme, function(opt)
			cfgMgr:SetValue("UIPositionPreset", opt)
			if opt == "Center" then
				mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
			elseif opt == "TopLeft" then
				mainFrame.Position = UDim2.new(0.32, 0, 0.35, 0)
			elseif opt == "BottomRight" then
				mainFrame.Position = UDim2.new(0.68, 0, 0.65, 0)
			end
		end)
		Controls.CreateDropdown(page, "Keybind Settings", { "RightShift", "LeftControl", "F4", "Insert" }, d.KeybindToggleUI, theme, function(opt)
			cfgMgr:SetValue("KeybindToggleUI", opt)
		end)
		Controls.CreateToggle(page, "Mobile Mode", "Adapta proporciones compactas para pantalla táctil", d.MobileMode, theme, function(v)
			cfgMgr:SetValue("MobileMode", v)
		end)

		Controls.CreateSectionHeader(page, "Configuration Profiles", theme)
		Controls.CreateActionButton(page, "Save Configuration", false, theme, function()
			local ok, msg = cfgMgr:Save()
			notifier:Notify({ Title = "Configuración", Message = msg, Kind = if ok then "Success" else "Warning" })
		end)
		Controls.CreateActionButton(page, "Load Configuration", false, theme, function()
			local ok, msg = cfgMgr:Load()
			playerSystem:ApplyNow()
			visualsSystem:Refresh()
			notifier:Notify({ Title = "Configuración", Message = msg, Kind = if ok then "Success" else "Warning" })
		end)
		Controls.CreateActionButton(page, "Reset Configuration", true, theme, function()
			Controls.ShowConfirmModal(modalLayer, "Restablecer configuración", "¿Deseas volver a los valores predeterminados del hub?", "Restablecer todo", theme, function()
				cfgMgr:Reset()
				mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
				adaptViewport()
				playerSystem:ResetToDefaults()
				visualsSystem:Refresh()
				notifier:Notify({ Title = "Configuración", Message = "Valores por defecto restaurados.", Kind = "Success" })
			end)
		end)
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end
		local keyName = cfgMgr.Data.KeybindToggleUI
		local keyEnum = (Enum.KeyCode :: any)[keyName]
		if keyEnum and input.KeyCode == keyEnum then
			mainFrame.Visible = not mainFrame.Visible
		end
	end)

	visualsSystem:Start()
	playerSystem:Start()
	roundSystem:Start()
end

buildHub()
