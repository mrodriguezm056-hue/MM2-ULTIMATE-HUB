local fovCorner = Instance.new("UICorner")
fovCorner.CornerRadius = UDim.new(1, 0)
fovCorner.Parent = fovCircle

UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return
	end
	if input.KeyCode == Enum.KeyCode.V then
		settingsMgr:SetValue("VisualsEnabled", not visuals:IsEnabled())
		visuals:SyncEntities(entityMgr:GetVisualEntities())
	elseif input.KeyCode == Enum.KeyCode.P then
		settingsMgr:SetValue("AutoPrediction", not engine.config.AutoPrediction)
	elseif input.KeyCode == Enum.KeyCode.F then
		cycleFilter()
	elseif input.KeyCode == Enum.KeyCode.G then
		cycleFirstTargetRole()
	elseif input.KeyCode == Enum.KeyCode.R then
		startRound()
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.E then
		fireTestShot()
	end
end)

local lastEntityRefresh = 0
local lastUiUpdate = 0
local lastViewport = Vector2.zero

RunService.RenderStepped:Connect(function(dt: number)
	local now = os.clock()
	local perf = perfMon:Step(dt, now)

	simCtrl:StepMotions(dt)
	engine:StepEvaluations(now)

	if now - lastEntityRefresh >= 0.25 then
		lastEntityRefresh = now
		entityMgr:Refresh(true)
		visuals:SyncEntities(entityMgr:GetVisualEntities())
	end

	if not camera then
		return
	end

	if camera.ViewportSize ~= lastViewport then
		lastViewport = camera.ViewportSize
		ui:UpdateScale(camera.ViewportSize)
	end

	local fovRadiusPx = selector:GetEffectiveFovRadius(camera)
	local refPoint = getRefScreenPoint()
	fovCircle.Size = UDim2.fromOffset(fovRadiusPx * 2, fovRadiusPx * 2)
	fovCircle.Position = UDim2.fromOffset(refPoint.X, refPoint.Y)

	local originPos = camera.CFrame.Position
	local candidates = entityMgr:GetSelectorCandidates()
	local best = selector:SelectBestTarget(
		camera,
		originPos,
		refPoint,
		candidates,
		player.Character,
		now
	)

	local targetName = "Ninguno"
	local targetRole = "--"
	local worldDist = 0
	local screenDist = 0
	local speed = 0
	local accel = 0
	local predTime = 0
	local offsetStuds = 0

	if best then
		targetName = best.targetId
		targetRole = tostring(best.role)
		worldDist = best.worldDistance
		screenDist = best.screenDistPx
		predTime = best.predictedTime
		offsetStuds = (best.predictedPos - best.currentPos).Magnitude

		local st = engine.targets[best.targetId]
		if st then
			speed = st.velocity.Magnitude
			accel = st.acceleration.Magnitude
		end

		local col = visuals:GetRoleColor(best.role)
		debugCtrl:UpdatePredictedMarker(best.predictedPos, col, true)
		debugCtrl:UpdateAimLine(originPos, best.predictedPos, col, settingsMgr:Get().DemoModeEnabled)
		fovStroke.Color = col
	else
		debugCtrl:UpdatePredictedMarker(nil, nil, false)
		debugCtrl:UpdateAimLine(nil, nil, nil, false)
		fovStroke.Color = Color3.fromRGB(130, 195, 255)
	end

	if now - lastUiUpdate >= 0.066 then
		lastUiUpdate = now
		local stats = telemetry:ComputeStats(nil)
		local logs = debugCtrl:GetRecentLogs(1)
		local latestLog = if logs[1] then logs[1].message else "Listo"
		local curS = settingsMgr:Get()

		ui:UpdateTelemetry({
			fps = perf.fps,
			targetName = targetName,
			targetRole = targetRole,
			worldDistStuds = worldDist,
			screenDistPx = screenDist,
			fovRadiusPx = fovRadiusPx,
			speedStudsPerSec = speed,
			accelStudsPerSec2 = accel,
			predTimeSec = predTime,
			offsetStuds = offsetStuds,
			meanErrorStuds = stats.meanError,
			maxErrorStuds = stats.maxError,
			lastErrorStuds = stats.lastError,
			sampleCount = stats.count,
			roundPhase = roundPhase,
			roundTimerSec = roundRemaining,
			autoPredEnabled = curS.AutoPrediction,
			visualsEnabled = curS.VisualsEnabled,
			silentAimEnabled = curS.SilentAimEnabled,
			demoModeEnabled = curS.DemoModeEnabled,
			filterName = FILTER_MODES[filterIdx].name,
			statusLog = latestLog,
		})
	end
end)

startRound()
