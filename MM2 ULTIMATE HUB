local StatsService = game:GetService("Stats")

export type PerfSnapshot = {
	fps: number,
	frameTimeMs: number,
	pingMs: number,
	memoryMb: number,
}

local PerformanceMonitor = {}
PerformanceMonitor.__index = PerformanceMonitor

function PerformanceMonitor.new(smoothingAlpha: number?): any
	local alpha = if type(smoothingAlpha) == "number" then math.clamp(smoothingAlpha, 0.02, 1.0) else 0.12
	local self = {
		alpha = alpha,
		smoothFps = 60,
		smoothFrameMs = 16.67,
		lastSampleTime = 0,
		cachedPingMs = 0,
		cachedMemMb = 0,
	}
	return setmetatable(self, PerformanceMonitor)
end

function PerformanceMonitor:Step(dt: number, now: number?): PerfSnapshot
	local safeDt = if type(dt) == "number" and dt > 1e-5 and dt < 1.0 then dt else (1 / 60)
	local instFps = 1 / safeDt
	local instMs = safeDt * 1000

	self.smoothFps = self.smoothFps + (instFps - self.smoothFps) * self.alpha
	self.smoothFrameMs = self.smoothFrameMs + (instMs - self.smoothFrameMs) * self.alpha

	local t = if type(now) == "number" then now else os.clock()
	if t - self.lastSampleTime >= 0.5 then
		self.lastSampleTime = t
		local okPing, pingItem = pcall(function()
			return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		if okPing and type(pingItem) == "number" and pingItem == pingItem then
			self.cachedPingMs = math.max(0, pingItem)
		end

		local okMem, memVal = pcall(function()
			return StatsService:GetTotalMemoryUsageMb()
		end)
		if okMem and type(memVal) == "number" and memVal == memVal then
			self.cachedMemMb = math.max(0, memVal)
		end
	end

	return {
		fps = self.smoothFps,
		frameTimeMs = self.smoothFrameMs,
		pingMs = self.cachedPingMs,
		memoryMb = self.cachedMemMb,
	}
end


