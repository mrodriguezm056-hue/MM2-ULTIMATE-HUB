local function getRefScreenPoint(): Vector2
	if not camera then
		return Vector2.zero
	end
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		return Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)
	end
	local m = UserInputService:GetMouseLocation()
	return Vector2.new(m.X, m.Y)
end

local function bindDummyMotions()
	simCtrl:ClearDummyMotions()
	for _, ent in ipairs(entityMgr:GetEntities()) do
		if ent.isDummy then
			if string.find(string.lower(ent.id), "zigzag") then
				simCtrl:SetDummyMotion(ent.id, ent.model, ent.anchorPart, "ZigZag", 15, 9)
			elseif string.find(string.lower(ent.id), "jump") then
				simCtrl:SetDummyMotion(ent.id, ent.model, ent.anchorPart, "Jump", 14, 8)
			elseif string.find(string.lower(ent.id), "linear") then
				simCtrl:SetDummyMotion(ent.id, ent.model, ent.anchorPart, "Linear", 16, 10)
			end
		end
	end
end

local function startRound()
	if roundThread then
		task.cancel(roundThread)
		roundThread = nil
	end

	engine:ClearAllTargets()
	entityMgr:Refresh(true)
	bindDummyMotions()

	local visualEntities = entityMgr:GetVisualEntities()
	local rolesMap: { [string]: RoleName } = {}

	local idx = 0
	for _, ent in ipairs(visualEntities) do
		idx += 1
		if ent.id == player.Name then
			rolesMap[ent.id] = "Innocent"
		elseif idx == 2 then
			rolesMap[ent.id] = "Murderer"
		elseif idx == 3 then
			rolesMap[ent.id] = "Sheriff"
		elseif idx == 4 then
			rolesMap[ent.id] = "Hero"
		else
			rolesMap[ent.id] = "Innocent"
		end
	end

	visuals:ClearRoles()
	visuals:AssignRolesBulk(rolesMap, true)
	roundPhase = "Preparation"
	roundRemaining = PREP_DURATION
	visuals:SetRoundState(true, "Preparation")
	visuals:SyncEntities(visualEntities)
	pushLog("INFO", "Ronda iniciada: 10s de preparación")

	roundThread = task.spawn(function()
		for sec = PREP_DURATION, 1, -1 do
			roundRemaining = sec
			task.wait(1)
		end
		roundPhase = "ActiveRound"
		roundRemaining = 0
		visuals:SetRoundState(true, "ActiveRound")
		visuals:SyncEntities(entityMgr:GetVisualEntities())
		pushLog("INFO", "Preparación finalizada: Ronda activa")
	end)
end

local function cycleFilter()
	filterIdx = (filterIdx % #FILTER_MODES) + 1
	local mode = FILTER_MODES[filterIdx]
	selector:SetConfig({ AllowedRoles = mode.allowed })
	pushLog("INFO", "Filtro -> " .. mode.name)
end

local function cycleFirstTargetRole()
	local candidates = entityMgr:GetSelectorCandidates()
	local first = candidates[1]
	if not first then
		pushLog("WARN", "Sin objetivos para rotar rol")
		return
	end
	manualRoleIdx = (manualRoleIdx % #ROLE_CYCLE) + 1
	local nextRole = ROLE_CYCLE[manualRoleIdx]
	visuals:AssignRole(first.id, nextRole)
	visuals:SyncEntities(entityMgr:GetVisualEntities())
	pushLog("INFO", string.format("%s -> %s", first.id, nextRole))
end

local lastFireTime = 0
local function fireTestShot()
	local now = os.clock()
	if now - lastFireTime < 0.35 or not camera then
		return
	end
	lastFireTime = now

	local currentSettings = settingsMgr:Get()
	local originPos = camera.CFrame.Position
	local fallbackDir = camera.CFrame.LookVector
	local refPoint = getRefScreenPoint()
	local candidates = entityMgr:GetSelectorCandidates()

	local aim = aimController:ResolveAim(
		camera,
		originPos,
		fallbackDir,
		refPoint,
		candidates,
		player.Character,
		now
	)

	local shotColor = if aim.role then visuals:GetRoleColor(aim.role) else Color3.fromRGB(255, 195, 95)
	local targetId = aim.targetId
	local targetModel = aim.targetModel
	local predictedAimPoint = aim.aimPoint
	local predTime = aim.predictedTime
	local worldDist = aim.worldDistance

	local st = if targetId then engine.targets[targetId] else nil
	local curSpeed = if st then st.velocity.Magnitude else 0

	if currentSettings.DemoModeEnabled then
		simCtrl:SpawnProjectile({
			originPos = originPos,
			direction = aim.direction,
			speed = math.max(currentSettings.ProjectileSpeed, 70),
			color = shotColor,
			targetModel = targetModel,
			maxLifetime = 2.2,
			onComplete = function(hitPos: Vector3, hitTarget: boolean, _hitInst: Instance?)
				showImpactMarker(hitPos, shotColor)

				if aim.hasTarget and targetId and targetModel then
					local anchor = targetModel:FindFirstChild("HumanoidRootPart") :: BasePart?
					local actualPos = if anchor and anchor.Parent then anchor.Position else hitPos
					local diffStuds = (predictedAimPoint - actualPos).Magnitude

					telemetry:Record({
						targetId = targetId,
						errorStuds = diffStuds,
						predictedTime = predTime,
						distanceStuds = worldDist,
						speedStudsPerSec = curSpeed,
						simulated = true,
						timestamp = os.clock(),
					})

					pushLog(
						"INFO",
						string.format(
							"Impacto (%s) | Pred vs Real: %.2f st | %s",
							targetId,
							diffStuds,
							if hitTarget then "HIT" else "MISS"
						)
					)
				end
			end,
		})
	end
end

