function DebugController.new(maxLogs: number?): any
	local limit = if type(maxLogs) == "number" and maxLogs >= 10 then math.floor(maxLogs) else 120
	local self = {
		logs = {} :: { DebugLogEntry },
		maxLogs = limit,
		markerPart = nil :: Part?,
		beamPart = nil :: Part?,
	}
	return setmetatable(self, DebugController)
end

function DebugController:Log(level: "INFO" | "WARN" | "ERROR", message: string, now: number?): DebugLogEntry
	local entry: DebugLogEntry = {
		level = level,
		message = tostring(message),
		timestamp = if type(now) == "number" then now else os.clock(),
	}
	table.insert(self.logs, entry)
	if #self.logs > self.maxLogs then
		table.remove(self.logs, 1)
	end
	return entry
end

function DebugController:GetRecentLogs(count: number?): { DebugLogEntry }
	local n = if type(count) == "number" and count > 0 then math.min(count, #self.logs) else #self.logs
	local out: { DebugLogEntry } = {}
	local startIdx = math.max(1, #self.logs - n + 1)
	for i = startIdx, #self.logs do
		table.insert(out, self.logs[i])
	end
	return out
end

function DebugController:ClearLogs()
	table.clear(self.logs)
end

local function ensureDebugPart(existing: Part?, name: string, color: Color3, shape: Enum.PartType): Part
	if existing and existing.Parent then
		existing.Color = color
		return existing
	end
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CastShadow = false
	p.Size = Vector3.new(0.7, 0.7, 0.7)
	p.Transparency = 1
	p.Parent = workspace
	return p
end

function DebugController:UpdatePredictedMarker(pos: Vector3?, color: Color3?, visible: boolean)
	local p = ensureDebugPart(
		self.markerPart,
		"NovaHub_PredMarker",
		color or Color3.fromRGB(130, 195, 255),
		Enum.PartType.Ball
	)
	self.markerPart = p

	if not visible or not pos then
		p.Transparency = 1
		return
	end

	p.Position = pos
	p.Transparency = 0
end

function DebugController:UpdateAimLine(originPos: Vector3?, aimPoint: Vector3?, color: Color3?, visible: boolean)
	local line = ensureDebugPart(
		self.beamPart,
		"NovaHub_AimLine",
		color or Color3.fromRGB(145, 130, 255),
		Enum.PartType.Block
	)
	self.beamPart = line

	if not visible or not originPos or not aimPoint then
		line.Transparency = 1
		return
	end

	local delta = aimPoint - originPos
	local dist = delta.Magnitude
	if dist <= 0.05 then
		line.Transparency = 1
		return
	end

	line.Size = Vector3.new(0.12, 0.12, dist)
	line.CFrame = CFrame.lookAt(originPos + delta * 0.5, aimPoint)
	line.Transparency = 0.35
end

function DebugController:DestroyVisuals()
	if self.markerPart then
		self.markerPart:Destroy()
		self.markerPart = nil
	end
	if self.beamPart then
		self.beamPart:Destroy()
		self.beamPart = nil
	end
end


