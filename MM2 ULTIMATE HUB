export type TelemetrySample = {
	id: number,
	targetId: string,
	errorStuds: number,
	predictedTime: number,
	distanceStuds: number,
	speedStudsPerSec: number,
	simulated: boolean,
	timestamp: number,
}

export type TelemetryStats = {
	count: number,
	lastError: number?,
	meanError: number?,
	maxError: number?,
	minError: number?,
}

local TelemetryController = {}
TelemetryController.__index = TelemetryController

function TelemetryController.new(maxSamples: number?): any
	local limit = if type(maxSamples) == "number" and maxSamples >= 10 then math.floor(maxSamples) else 1000
	local self = {
		samples = {} :: { TelemetrySample },
		maxSamples = limit,
		nextId = 1,
	}
	return setmetatable(self, TelemetryController)
end

function TelemetryController:Record(entry: {
	targetId: string,
	errorStuds: number,
	predictedTime: number?,
	distanceStuds: number?,
	speedStudsPerSec: number?,
	simulated: boolean?,
	timestamp: number?,
}): TelemetrySample?
	local err = entry.errorStuds
	if type(err) ~= "number" or err ~= err or math.abs(err) == math.huge or err < 0 then
		return nil
	end

	local sample: TelemetrySample = {
		id = self.nextId,
		targetId = tostring(entry.targetId),
		errorStuds = err,
		predictedTime = if type(entry.predictedTime) == "number" then math.max(0, entry.predictedTime) else 0,
		distanceStuds = if type(entry.distanceStuds) == "number" then math.max(0, entry.distanceStuds) else 0,
		speedStudsPerSec = if type(entry.speedStudsPerSec) == "number" then math.max(0, entry.speedStudsPerSec) else 0,
		simulated = if entry.simulated == nil then false else entry.simulated == true,
		timestamp = if type(entry.timestamp) == "number" then entry.timestamp else os.clock(),
	}

	self.nextId += 1
	table.insert(self.samples, sample)
	if #self.samples > self.maxSamples then
		table.remove(self.samples, 1)
	end

	return sample
end

function TelemetryController:Clear()
	table.clear(self.samples)
end

function TelemetryController:GetHistory(options: {
	targetId: string?,
	simulated: boolean?,
	windowSeconds: number?,
	now: number?,
}?): { TelemetrySample }
	local opts = options or {}
	local tNow = if type(opts.now) == "number" then opts.now else os.clock()
	local minTime: number? = if type(opts.windowSeconds) == "number" and opts.windowSeconds > 0
		then (tNow - opts.windowSeconds)
		else nil

	local result: { TelemetrySample } = {}
	for _, s in ipairs(self.samples) do
		local okId = (opts.targetId == nil or s.targetId == opts.targetId)
		local okSim = (opts.simulated == nil or s.simulated == opts.simulated)
		local okTime = (minTime == nil or s.timestamp >= minTime)
		if okId and okSim and okTime then
			table.insert(result, s)
		end
	end
	return result
end

function TelemetryController:ComputeStats(options: {
	targetId: string?,
	simulated: boolean?,
	windowSeconds: number?,
	now: number?,
}?): TelemetryStats
	local list = self:GetHistory(options)
	local count = #list
	if count == 0 then
		return { count = 0, lastError = nil, meanError = nil, maxError = nil, minError = nil }
	end

	local sum = 0
	local minErr = list[1].errorStuds
	local maxErr = list[1].errorStuds
	local lastErr = list[count].errorStuds

	for _, s in ipairs(list) do
		sum += s.errorStuds
		if s.errorStuds < minErr then
			minErr = s.errorStuds
		end
		if s.errorStuds > maxErr then
			maxErr = s.errorStuds
		end
		lastErr = s.errorStuds
	end

	return {
		count = count,
		lastError = lastErr,
		meanError = sum / count,
		maxError = maxErr,
		minError = minErr,
	}
end


