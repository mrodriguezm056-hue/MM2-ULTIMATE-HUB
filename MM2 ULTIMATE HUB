local Notifications = {}
Notifications.__index = Notifications

function Notifications.new(parent: Instance, theme: any)
	local holder = Instance.new("Frame")
	holder.Name = "NotificationsContainer"
	holder.AnchorPoint = Vector2.new(1, 1)
	holder.Position = UDim2.new(1, -16, 1, -16)
	holder.Size = UDim2.new(0, 290, 0, 240)
	holder.BackgroundTransparency = 1
	holder.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.Padding = UDim.new(0, 8)
	layout.Parent = holder

	return setmetatable({
		Holder = holder,
		Theme = theme,
		Enabled = true,
	}, Notifications)
end

function Notifications:SetEnabled(enabled: boolean)
	self.Enabled = enabled
	self.Holder.Visible = enabled
end

function Notifications:Notify(payload: NotificationPayload)
	if not self.Enabled then
		return
	end
	local palette: Palette = self.Theme:GetPalette()
	local accent = palette.PrimaryAccent
	if payload.Kind == "Success" then
		accent = palette.Success
	elseif payload.Kind == "Warning" then
		accent = palette.Warning
	end

	local toast = Instance.new("Frame")
	toast.Name = "Toast"
	toast.Size = UDim2.new(1, 0, 0, 56)
	toast.BackgroundColor3 = palette.Surface
	toast.BackgroundTransparency = math.clamp(self.Theme.Transparency + 0.04, 0, 0.5)
	toast.BorderSizePixel = 0
	toast.ClipsDescendants = true
	toast.Parent = self.Holder

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = toast

	local stroke = Instance.new("UIStroke")
	stroke.Color = accent
	stroke.Thickness = 1
	stroke.Transparency = 0.35
	stroke.Parent = toast

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(0, 4, 1, -12)
	bar.Position = UDim2.new(0, 8, 0, 6)
	bar.BackgroundColor3 = accent
	bar.BorderSizePixel = 0
	bar.Parent = toast
	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

	local titleLbl = Instance.new("TextLabel")
	titleLbl.BackgroundTransparency = 1
	titleLbl.Position = UDim2.new(0, 20, 0, 7)
	titleLbl.Size = UDim2.new(1, -28, 0, 18)
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.Text = payload.Title
	titleLbl.TextColor3 = palette.TextPrimary
	titleLbl.TextSize = 13
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = toast

	local msgLbl = Instance.new("TextLabel")
	msgLbl.BackgroundTransparency = 1
	msgLbl.Position = UDim2.new(0, 20, 0, 25)
	msgLbl.Size = UDim2.new(1, -28, 0, 24)
	msgLbl.Font = Enum.Font.Gotham
	msgLbl.Text = payload.Message
	msgLbl.TextColor3 = palette.TextSecondary
	msgLbl.TextSize = 11
	msgLbl.TextWrapped = true
	msgLbl.TextXAlignment = Enum.TextXAlignment.Left
	msgLbl.TextYAlignment = Enum.TextYAlignment.Top
	msgLbl.Parent = toast

	task.delay(payload.Duration or 2.8, function()
		if toast and toast.Parent then
			local outTween = self.Theme:Tween(toast, { BackgroundTransparency = 1 }, 0.22)
			outTween.Completed:Once(function()
				if toast then
					toast:Destroy()
				end
			end)
		end
	end)
end

local Navigation = {}
Navigation.__index = Navigation

function Navigation.new(theme: any)
	return setmetatable({
		Tabs = {} :: { [TabId]: { Id: TabId, Label: string, Button: TextButton, Page: ScrollingFrame } },
		ActiveTab = nil :: TabId?,
		Theme = theme,
	}, Navigation)
end

function Navigation:Register(id: TabId, label: string, button: TextButton, page: ScrollingFrame)
	self.Tabs[id] = { Id = id, Label = label, Button = button, Page = page }
	button.MouseButton1Click:Connect(function()
		self:Select(id)
	end)
end

function Navigation:RefreshStyles()
	local palette: Palette = self.Theme:GetPalette()
	for id, entry in pairs(self.Tabs) do
		local selected = (self.ActiveTab == id)
		entry.Button.BackgroundColor3 = if selected then palette.SurfaceHover else palette.Sidebar
		entry.Button.TextColor3 = if selected then palette.PrimaryAccent else palette.TextSecondary
		local stroke = entry.Button:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if selected then palette.PrimaryAccent else palette.Border
			stroke.Transparency = if selected then 0.25 else 0.7
		end
	end
end

function Navigation:Select(id: TabId)
	local target = self.Tabs[id]
	if not target or self.ActiveTab == id then
		return
	end
	self.ActiveTab = id
	for tabId, entry in pairs(self.Tabs) do
		if tabId == id then
			entry.Page.Visible = true
			entry.Page.Position = UDim2.new(0, 12, 0, 0)
			entry.Page.CanvasPosition = Vector2.zero
			self.Theme:Tween(entry.Page, { Position = UDim2.new(0, 0, 0, 0) }, 0.18)
		else
			entry.Page.Visible = false
		end
	end
	self:RefreshStyles()
end

