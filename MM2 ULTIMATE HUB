-- 2. ReplicatedStorage/RoleVisualsController (ModuleScript)
-- ============================================================================
export type RoleName = "Innocent" | "Sheriff" | "Hero" | "Murderer"
export type RoleOrUnknown = RoleName | "Unknown"
export type RoundPhase = "Idle" | "Preparation" | "ActiveRound"

local ROLE_COLORS: { [RoleOrUnknown]: Color3 } = {
	Innocent = Color3.fromRGB(70, 235, 120),
	Sheriff = Color3.fromRGB(75, 155, 255),
	Hero = Color3.fromRGB(255, 220, 75),
	Murderer = Color3.fromRGB(255, 75, 85),
	Unknown = Color3.fromRGB(165, 175, 190),
}

local HIGHLIGHT_NAME = "RoleVisualHighlight_Debug"

local RoleVisualsController = {}
RoleVisualsController.__index = RoleVisualsController

function RoleVisualsController.new(): any
	local self = {
		enabled = false,
		roundActive = false,
		phase = "Idle" :: RoundPhase,
		fillTransparency = 0.55,
		outlineTransparency = 0.05,
		roleByTargetId = {} :: { [string]: RoleName },
		highlightsByModel = {} :: { [Model]: Highlight },
	}
	return setmetatable(self, RoleVisualsController)
end

function RoleVisualsController:GetRoleColor(role: RoleOrUnknown): Color3
	return ROLE_COLORS[role] or ROLE_COLORS.Unknown
end

function RoleVisualsController:SetRoleColor(role: RoleOrUnknown, color: Color3)
	ROLE_COLORS[role] = color
	self:RefreshColors()
end

function RoleVisualsController:SetTransparencies(fillTransp: number, outlineTransp: number)
	self.fillTransparency = math.clamp(fillTransp, 0, 1)
	self.outlineTransparency = math.clamp(outlineTransp, 0, 1)
	self:RefreshColors()
end

function RoleVisualsController:GetRole(targetId: string): RoleOrUnknown
	return self.roleByTargetId[targetId] or "Unknown"
end

function RoleVisualsController:SetEnabled(enabled: boolean)
	self.enabled = enabled == true
	self:RefreshAll()
end

function RoleVisualsController:IsEnabled(): boolean
	return self.enabled
end

function RoleVisualsController:SetRoundState(active: boolean, phase: RoundPhase)
	self.roundActive = active == true
	self.phase = phase
	if phase == "Idle" or not self.roundActive then
		self:ClearAllHighlights()
	else
		self:RefreshAll()
	end
end

function RoleVisualsController:AssignRole(targetId: string, role: RoleName?)
	if role == nil then
		self.roleByTargetId[targetId] = nil
	else
		self.roleByTargetId[targetId] = role
	end
	self:RefreshColors()
end

function RoleVisualsController:AssignRolesBulk(rolesMap: { [string]: RoleName }, replaceExisting: boolean?)
	if replaceExisting then
		table.clear(self.roleByTargetId)
	end
	for targetId, role in pairs(rolesMap) do
		self.roleByTargetId[targetId] = role
	end
	self:RefreshColors()
end

function RoleVisualsController:ClearRoles()
	table.clear(self.roleByTargetId)
	self:RefreshColors()
end

function RoleVisualsController:ClearAllHighlights()
	for model, hl in pairs(self.highlightsByModel) do
		if hl and hl.Parent then
			hl:Destroy()
		elseif model and model.Parent then
			local existing = model:FindFirstChild(HIGHLIGHT_NAME)
			if existing then
				existing:Destroy()
			end
		end
		self.highlightsByModel[model] = nil
	end
end

local function ensureHighlight(model: Model, fillT: number, outlineT: number): Highlight
	local existing = model:FindFirstChild(HIGHLIGHT_NAME)
	local hl: Highlight
	if existing and existing:IsA("Highlight") then
		hl = existing
	else
		hl = Instance.new("Highlight")
		hl.Name = HIGHLIGHT_NAME
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = model
	end
	hl.FillTransparency = fillT
	hl.OutlineTransparency = outlineT
	return hl
end

function RoleVisualsController:RefreshColors()
	for model, hl in pairs(self.highlightsByModel) do
		if not model.Parent or not hl.Parent then
			self.highlightsByModel[model] = nil
		else
			local targetId = hl:GetAttribute("TargetId")
			local role: RoleOrUnknown = if type(targetId) == "string" then self:GetRole(targetId) else "Unknown"
			local col = self:GetRoleColor(role)
			hl.FillColor = col
			hl.OutlineColor = col
			hl.FillTransparency = self.fillTransparency
			hl.OutlineTransparency = self.outlineTransparency
		end
	end
end

function RoleVisualsController:SyncEntities(entities: { { id: string, model: Model } })
	local shouldShow = self.enabled and self.roundActive and (self.phase == "Preparation" or self.phase == "ActiveRound")
	if not shouldShow then
		self:ClearAllHighlights()
		return
	end

	local activeModels: { [Model]: boolean } = {}

	for _, entry in ipairs(entities) do
		local model = entry.model
		if model and model.Parent then
			activeModels[model] = true
			local role = self:GetRole(entry.id)
			local hl = ensureHighlight(model, self.fillTransparency, self.outlineTransparency)
			local col = self:GetRoleColor(role)
			hl:SetAttribute("TargetId", entry.id)
			hl.FillColor = col
			hl.OutlineColor = col
			hl.Enabled = true
			self.highlightsByModel[model] = hl
		end
	end

	for model, hl in pairs(self.highlightsByModel) do
		if not activeModels[model] then
			if hl and hl.Parent then
				hl:Destroy()
			end
			self.highlightsByModel[model] = nil
		end
	end
end

function RoleVisualsController:RefreshAll()
	local shouldShow = self.enabled and self.roundActive and (self.phase == "Preparation" or self.phase == "ActiveRound")
	if not shouldShow then
		self:ClearAllHighlights()
		return
	end
	self:RefreshColors()
end


