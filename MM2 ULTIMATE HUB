	desc.Text = subText
	desc.TextColor3 = palette.TextSecondary
	desc.TextSize = 11
	desc.TextTruncate = Enum.TextTruncate.AtEnd
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.Parent = row

	local hit = Instance.new("TextButton")
	hit.AnchorPoint = Vector2.new(1, 0.5)
	hit.Position = UDim2.new(1, -12, 0.5, 0)
	hit.Size = UDim2.new(0, 48, 0, 28)
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.BorderSizePixel = 0
	hit.Parent = row
	applyCorner(hit, 14)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 22, 0, 22)
	knob.Position = UDim2.new(0, 3, 0.5, -11)
	knob.BackgroundColor3 = palette.TextPrimary
	knob.BorderSizePixel = 0
	knob.Parent = hit
	applyCorner(knob, 11)

	local function renderState(animated: boolean)
		local p: Palette = theme:GetPalette()
		local targetBg = if state then p.PrimaryAccent else p.SurfaceHover
		local targetPos = if state then UDim2.new(1, -25, 0.5, -11) else UDim2.new(0, 3, 0.5, -11)
		if animated then
			theme:Tween(hit, { BackgroundColor3 = targetBg }, 0.16)
			theme:Tween(knob, { Position = targetPos }, 0.16)
		else
			hit.BackgroundColor3 = targetBg
			knob.Position = targetPos
		end
	end

	hit.MouseButton1Click:Connect(function()
		state = not state
		renderState(true)
		onChanged(state)
	end)

	renderState(false)
	return row, function(newState: boolean)
		state = newState
		renderState(false)
	end
end

function Controls.CreateSlider(
	parent: Instance,
	labelText: string,
	minVal: number,
	maxVal: number,
	step: number,
	initialVal: number,
	suffix: string?,
	theme: any,
	onChanged: (number) -> ()
): (Frame, (number) -> ())
	local palette: Palette = theme:GetPalette()
	local current = math.clamp(initialVal, minVal, maxVal)
	local dragging = false

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 54)
	row.BackgroundColor3 = palette.Surface
	row.BackgroundTransparency = math.clamp(theme.Transparency, 0, 0.4)
	row.BorderSizePixel = 0
	row.Parent = parent
	applyCorner(row, 10)
	applyStroke(row, palette.Border, 0.65)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.new(0, 12, 0, 7)
	title.Size = UDim2.new(0.65, -12, 0, 18)
	title.Font = Enum.Font.GothamMedium
	title.Text = labelText
	title.TextColor3 = palette.TextPrimary
	title.TextSize = 13
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = row

	local valueLbl = Instance.new("TextLabel")
	valueLbl.BackgroundTransparency = 1
	valueLbl.Position = UDim2.new(0.65, 0, 0, 7)
	valueLbl.Size = UDim2.new(0.35, -12, 0, 18)
	valueLbl.Font = Enum.Font.GothamBold
	valueLbl.TextColor3 = palette.PrimaryAccent
	valueLbl.TextSize = 12
	valueLbl.TextXAlignment = Enum.TextXAlignment.Right
	valueLbl.Parent = row

	local track = Instance.new("TextButton")
	track.Position = UDim2.new(0, 12, 0, 32)
	track.Size = UDim2.new(1, -24, 0, 12)
	track.BackgroundColor3 = palette.SurfaceHover
	track.Text = ""
	track.AutoButtonColor = false
	track.BorderSizePixel = 0
	track.Parent = row
	applyCorner(track, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = palette.PrimaryAccent
	fill.BorderSizePixel = 0
	fill.Parent = track
	applyCorner(fill, 6)

	local function formatValue(v: number): string
		local rounded = math.clamp(math.floor((v / step) + 0.5) * step, minVal, maxVal)
		if step >= 1 then
			return tostring(math.floor(rounded + 0.5)) .. (suffix or "")
		end
		return string.format("%.2f", rounded) .. (suffix or "")
	end

	local function applyVisual(val: number)
		current = math.clamp(val, minVal, maxVal)
		local ratio = if maxVal > minVal then (current - minVal) / (maxVal - minVal) else 0
		fill.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
		valueLbl.Text = formatValue(current)
	end

	local function updateFromInput(inputPosX: number)
		local absPos = track.AbsolutePosition.X
		local absSize = math.max(1, track.AbsoluteSize.X)
		local alpha = math.clamp((inputPosX - absPos) / absSize, 0, 1)
		local raw = minVal + alpha * (maxVal - minVal)
		local snapped = math.clamp(math.floor((raw / step) + 0.5) * step, minVal, maxVal)
		if snapped ~= current then
			applyVisual(snapped)
			onChanged(snapped)
		end
	end

	track.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input: InputObject)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	applyVisual(current)
	return row, function(newVal: number)
		applyVisual(newVal)
	end
end

