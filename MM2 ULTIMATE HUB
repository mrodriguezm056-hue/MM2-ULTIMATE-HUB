local function cloneDefaults(): HubConfig
	return table.clone(DEFAULT_CONFIG)
end

local ConfigurationManager = {}
ConfigurationManager.__index = ConfigurationManager

function ConfigurationManager.new(storageKey: string?, adapter: PersistenceAdapter?)
	return setmetatable({
		Data = cloneDefaults(),
		StorageKey = storageKey or "MM2UltimateHub_Config_v1",
		Adapter = adapter,
		Listeners = {} :: { (HubConfig) -> () },
	}, ConfigurationManager)
end

function ConfigurationManager:OnChanged(callback: (HubConfig) -> ())
	table.insert(self.Listeners, callback)
	local idx = #self.Listeners
	callback(self.Data)
	return {
		Disconnect = function()
			table.remove(self.Listeners, idx)
		end,
	}
end

function ConfigurationManager:Emit()
	for _, fn in ipairs(self.Listeners) do
		fn(self.Data)
	end
end

function ConfigurationManager:SetValue(key: string, value: any)
	(self.Data :: any)[key] = value
	self:Emit()
end

function ConfigurationManager:Save(): (boolean, string)
	local okEncode, encoded = pcall(function()
		return HttpService:JSONEncode(self.Data)
	end)
	if not okEncode or type(encoded) ~= "string" then
		return false, "Error al serializar la configuración."
	end
	if self.Adapter then
		local okWrite = pcall(function()
			return self.Adapter.Write(self.StorageKey, encoded)
		end)
		if okWrite then
			return true, "Configuración guardada mediante adaptador."
		end
		return false, "El adaptador de almacenamiento rechazó la escritura."
	end
	return true, "Configuración guardada en memoria de sesión."
end

function ConfigurationManager:Load(): (boolean, string)
	if not self.Adapter then
		self:Emit()
		return true, "Sesión activa cargada en memoria."
	end
	local okRead, raw = pcall(function()
		return self.Adapter.Read(self.StorageKey)
	end)
	if not okRead or type(raw) ~= "string" or raw == "" then
		return false, "No se encontró configuración guardada previa."
	end
	local okDecode, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not okDecode or type(decoded) ~= "table" then
		return false, "Datos guardados corruptos o ilegibles."
	end
	local merged = cloneDefaults()
	for k, v in pairs(decoded) do
		if (merged :: any)[k] ~= nil and typeof(v) == typeof((merged :: any)[k]) then
			(merged :: any)[k] = v
		end
	end
	self.Data = merged
	self:Emit()
	return true, "Configuración cargada correctamente."
end

function ConfigurationManager:Reset()
	self.Data = cloneDefaults()
	self:Emit()
end

